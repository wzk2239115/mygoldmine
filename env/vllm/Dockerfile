# generated by scripts/env/build_env.sh
# project=vllm commit=20bf65a source=/home/wzk/mygoldmine/targets/vllm
FROM mygoldmine:dev
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates build-essential pkg-config cmake \
 && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
COPY --chown=miner:miner . /opt/target
WORKDIR /opt/target
RUN python3 -m pip install --no-cache-dir -e . --no-deps && \
    cd '/opt/target/rust' && . "$HOME/.cargo/env" && (cargo fetch --locked || cargo fetch)
RUN chown -R miner:miner /opt/target
USER miner
ENV MYGOLDMINE_PROJECT=vllm \
    MYGOLDMINE_COMMIT=20bf65a \
    MYGOLDMINE_TARGET=/opt/target \
    MYGOLDMINE_MODE=auto
LABEL mygoldmine.project=vllm \
      mygoldmine.commit=20bf65a \
      mygoldmine.mode=auto \
      mygoldmine.source=/home/wzk/mygoldmine/targets/vllm
WORKDIR /opt/target
