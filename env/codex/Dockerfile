# generated by scripts/env/build_env.sh
# project=codex commit=970111f source=/home/wzk/mygoldmine/targets/codex
FROM mygoldmine:dev
USER root
ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates build-essential pkg-config \
 && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH=/opt/cargo/bin:$PATH
COPY --chown=miner:miner . /opt/target
WORKDIR /opt/target
RUN npm install -g pnpm && pnpm install --frozen-lockfile --ignore-scripts && \
    cd '/opt/target/codex-rs' && (cargo fetch --locked || cargo fetch)
RUN chown -R miner:miner /opt/target /opt/cargo /opt/rustup 2>/dev/null || chown -R miner:miner /opt/target
USER miner
ENV MYGOLDMINE_PROJECT=codex \
    MYGOLDMINE_COMMIT=970111f \
    MYGOLDMINE_TARGET=/opt/target \
    MYGOLDMINE_MODE=auto
LABEL mygoldmine.project=codex \
      mygoldmine.commit=970111f \
      mygoldmine.mode=auto \
      mygoldmine.source=/home/wzk/mygoldmine/targets/codex
WORKDIR /opt/target
