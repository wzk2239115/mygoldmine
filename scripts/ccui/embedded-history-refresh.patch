+import { renderHook } from '@testing-library/react';
+import { describe, expect, it, vi } from 'vitest';
+import { useEmbeddedHistoryRefresh } from '@/modules/chat/hooks/useEmbeddedHistoryRefresh';
+
+function announce(overrides: MessageEventInit = {}) {
+  window.dispatchEvent(new MessageEvent('message', {
+    origin: window.location.origin,
+    source: window.parent,
+    data: { type: 'mygoldmine:history-updated', sessionId: 'audit-1' },
+    ...overrides,
+  }));
+}
+
+describe('embedded audit history updates', () => {
+  it('refreshes the active history through the store without navigating', () => {
+    const refresh = vi.fn().mockResolvedValue(undefined);
+    const { unmount } = renderHook(() => useEmbeddedHistoryRefresh('audit-1', refresh));
+    announce();
+    expect(refresh).toHaveBeenCalledTimes(1);
+    unmount();
+    announce();
+    expect(refresh).toHaveBeenCalledTimes(1);
+  });
+
+  it('ignores other origins, sources, sessions and message types', () => {
+    const refresh = vi.fn().mockResolvedValue(undefined);
+    renderHook(() => useEmbeddedHistoryRefresh('audit-1', refresh));
+    announce({ origin: 'https://other.invalid' });
+    announce({ source: null });
+    announce({ data: { type: 'mygoldmine:history-updated', sessionId: 'other' } });
+    announce({ data: { type: 'unrelated', sessionId: 'audit-1' } });
+    expect(refresh).not.toHaveBeenCalled();
+  });
+
+  it('cleans up the previous session listener on a session switch', () => {
+    const refresh = vi.fn().mockResolvedValue(undefined);
+    const { rerender } = renderHook(({ id }) => useEmbeddedHistoryRefresh(id, refresh), {
+      initialProps: { id: 'audit-1' },
+    });
+    rerender({ id: 'audit-2' });
+    announce();
+    expect(refresh).not.toHaveBeenCalled();
+    announce({ data: { type: 'mygoldmine:history-updated', sessionId: 'audit-2' } });
+    expect(refresh).toHaveBeenCalledTimes(1);
+  });
+});
