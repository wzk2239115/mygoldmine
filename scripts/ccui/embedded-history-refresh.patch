@@ -849,0 +851,20 @@ export function useChatSessionState({
+  // Imported read-only audit runs use the same incremental store path as live history.
+  const refreshEmbeddedHistory = useCallback(async () => {
+    if (!activeSessionId || !isActiveRef.current) return;
+    const follow = isNearBottom();
+    const previousCount = sessionStore.getMessages(activeSessionId).length;
+    await requestLatestMessages(activeSessionId);
+    if (activeSessionIdRef.current !== activeSessionId) return;
+    const added = sessionStore.getMessages(activeSessionId).length - previousCount;
+    if (!follow && added > 0) {
+      // A tail-sliced window must grow while reading older rows so its start stays fixed.
+      setVisibleMessageCount(count => count + added);
+    }
+    if (follow) {
+      requestAnimationFrame(() => {
+        if (!isUserScrolledUpRef.current) scrollToBottom();
+      });
+    }
+  }, [activeSessionId, requestLatestMessages, scrollToBottom, sessionStore]);
+  useEmbeddedHistoryRefresh(activeSessionId, refreshEmbeddedHistory);
+
