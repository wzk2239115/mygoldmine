@@ -0,0 +1,22 @@
+import { useEffect } from 'react';
+
+/** Used by the chat history hook to merge parent-imported audit messages without navigation. */
+export function useEmbeddedHistoryRefresh(
+  sessionId: string | null,
+  refresh: () => Promise<void>,
+): void {
+  useEffect(() => {
+    const receive = (event: MessageEvent) => {
+      // Only the same-origin embedding parent may refresh the selected session.
+      if (event.origin !== window.location.origin || event.source !== window.parent) return;
+      if (event.data?.type !== 'mygoldmine:history-updated') return;
+      if (!sessionId || event.data.sessionId !== sessionId) return;
+      void refresh().catch(error => console.error('Embedded history refresh failed:', error));
+    };
+    window.addEventListener('message', receive);
+    if (sessionId && window.parent !== window) {
+      window.parent.postMessage({ type: 'mygoldmine:history-ready', sessionId }, window.location.origin);
+    }
+    return () => window.removeEventListener('message', receive);
+  }, [sessionId, refresh]);
+}
