FROM node:22-bookworm-slim AS node
FROM python:3.13-slim
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN sed -i 's|http://deb.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g; s|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g' /etc/apt/sources.list.d/debian.sources && apt-get update && apt-get install -y --no-install-recommends git gcc g++ make curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple 'tree-sitter>=0.20,<0.22' tiktoken openai anthropic google-generativeai boto3 tqdm networkx streamlit pyyaml requests
RUN npm install -g @anthropic-ai/claude-code@2.1.318
COPY tools/strix /opt/strix
RUN chmod -R a+rX /opt/strix && pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -e /opt/strix
