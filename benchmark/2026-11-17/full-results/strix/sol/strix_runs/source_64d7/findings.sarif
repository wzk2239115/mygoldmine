                },
                "region": {
                  "startLine": 865,
                  "endLine": 867,
                  "snippet": {
                    "text": "mqtt_unpack(c->rbuf + c->rpos, &io.data, *c->rbuf, c->read - c->rpos);\n    c->toread = c->read = c->rpos = 0;\n    c->rc = handle_command(io.data.header.bits.type, &io);"
                  }
                }
              },
              "message": {
                "text": "process_message: do not dispatch a packet whose decoding failed"
              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "MQTT SUBSCRIBE (0x82) and UNSUBSCRIBE (0xA2) packet decoders",
                  "kind": "endpoint"
                }
              ]
            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/mqtt.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 324,
                        "endLine": 367
                      },
                      "insertedContent": {
                        "text": "static int unpack_mqtt_subscribe(u8 *buf, struct mqtt_packet *pkt, usize len)\n{\n\n    struct mqtt_subscribe subscribe;\n    subscribe.tuples = NULL;\n\n    /*\n     * The packet identifier plus at least one complete 3-tuple (2 bytes topic\n     * length, the topic filter and 1 byte of qos) must be covered by the\n     * length declared in the fixed header\n     */\n    if (len < sizeof(u16) + sizeof(u16) + sizeof(u8))\n        return -MQTT_ERR;\n\n    /* Read packet id */\n    subscribe.pkt_id = unpack_integer(&buf, 'H');\n    len -= sizeof(u16);\n\n    /*\n     * Read in a loop all remaining bytes specified by len of the Fixed Header.\n     * From now on the payload consists of 3-tuples formed by:\n     *  - topic length\n     *  - topic filter (string)\n     *  - qos\n     */\n    usize i = 0;\n    for (; len > 0; ++i) {\n\n        /*\n         * A tuple needs at least its 2 bytes topic length plus 1 byte of qos,\n         * a shorter remainder means the declared length does not match the\n         * bytes actually available: stop before the subtraction below wraps\n         */\n        if (len < sizeof(u16) + sizeof(u8))\n            goto err;\n\n        /*\n         * The tuple counter is stored on 2 bytes, a longer list would be\n         * silently truncated\n         */\n        if (i == UINT16_MAX)\n            goto err;\n\n        /* Read length bytes of the first topic filter */\n        len -= sizeof(u16);\n\n        /* We have to make room for additional incoming tuples */\n        subscribe.tuples =\n            try_realloc(subscribe.tuples, (i + 1) * sizeof(*subscribe.tuples));\n        subscribe.tuples[i].topic_len =\n            unpack_string16(&buf, &subscribe.tuples[i].topic);\n\n        if (!subscribe.tuples[i].topic)\n            goto err;\n\n        /*\n         * The topic length is declared by the client itself, it must fit in\n         * what is left of the packet, otherwise the subtraction below wraps\n         */\n        if (subscribe.tuples[i].topic_len > len) {\n            free_memory(subscribe.tuples[i].topic);\n            goto err;\n        }\n\n        len -= subscribe.tuples[i].topic_len;\n        subscribe.tuples[i].qos = unpack_integer(&buf, 'B');\n        len -= sizeof(u8);\n    }\n\n    subscribe.tuples_len = i;\n    pkt->subscribe       = subscribe;\n\n    return MQTT_OK;\n\nerr:\n    /* Release the tuples decoded so far, no one else references them */\n    for (usize k = 0; k < i; ++k)\n        free_memory(subscribe.tuples[k].topic);\n    free_memory(subscribe.tuples);\n    return -MQTT_ERR;\n}"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/mqtt.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 369,
                        "endLine": 410
                      },
                      "insertedContent": {
                        "text": "static int unpack_mqtt_unsubscribe(u8 *buf, struct mqtt_packet *pkt, usize len)\n{\n\n    struct mqtt_unsubscribe unsubscribe;\n    unsubscribe.tuples = NULL;\n\n    /*\n     * The packet identifier plus at least one complete 2-tuple (2 bytes topic\n     * length and the topic filter) must be covered by the length declared in\n     * the fixed header\n     */\n    if (len < sizeof(u16) + sizeof(u16))\n        return -MQTT_ERR;\n\n    /* Read packet id */\n    unsubscribe.pkt_id = unpack_integer(&buf, 'H');\n    len -= sizeof(u16);\n\n    /*\n     * Read in a loop all remaining bytes specified by len of the Fixed Header.\n     * From now on the payload consists of 2-tuples formed by:\n     *  - topic length\n     *  - topic filter (string)\n     */\n    usize i = 0;\n    for (; len > 0; ++i) {\n\n        /*\n         * A tuple needs at least its 2 bytes topic length, a shorter\n         * remainder means the declared length does not match the bytes\n         * actually available: stop before the subtraction below wraps\n         */\n        if (len < sizeof(u16))\n            goto err;\n\n        /*\n         * The tuple counter is stored on 2 bytes, a longer list would be\n         * silently truncated\n         */\n        if (i == UINT16_MAX)\n            goto err;\n\n        /* Read length bytes of the first topic filter */\n        len -= sizeof(u16);\n\n        /* We have to make room for additional incoming tuples */\n        unsubscribe.tuples = try_realloc(unsubscribe.tuples,\n                                         (i + 1) * sizeof(*unsubscribe.tuples));\n        unsubscribe.tuples[i].topic_len =\n            unpack_string16(&buf, &unsubscribe.tuples[i].topic);\n\n        if (!unsubscribe.tuples[i].topic)\n            goto err;\n\n        /*\n         * The topic length is declared by the client itself, it must fit in\n         * what is left of the packet, otherwise the subtraction below wraps\n         */\n        if (unsubscribe.tuples[i].topic_len > len) {\n            free_memory(unsubscribe.tuples[i].topic);\n            goto err;\n        }\n\n        len -= unsubscribe.tuples[i].topic_len;\n    }\n\n    unsubscribe.tuples_len = i;\n    pkt->unsubscribe       = unsubscribe;\n\n    return MQTT_OK;\n\nerr:\n    /* Release the tuples decoded so far, no one else references them */\n    for (usize k = 0; k < i; ++k)\n        free_memory(unsubscribe.tuples[k].topic);\n    free_memory(unsubscribe.tuples);\n    return -MQTT_ERR;\n}"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/server.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 865,
                        "endLine": 867
                      },
                      "insertedContent": {
                        "text": "int rc =\n        mqtt_unpack(c->rbuf + c->rpos, &io.data, *c->rbuf, c->read - c->rpos);\n    c->toread = c->read = c->rpos = 0;\n\n    /*\n     * A packet that could not be decoded must not reach the command handlers,\n     * they assume a fully populated packet: reset the client state machine and\n     * wait for the next one instead\n     */\n    if (rc != MQTT_OK) {\n        log_debug(\"Malformed packet from %s, discarding\", c->conn.ip);\n        c->status = WAITING_HEADER;\n        return;\n    }\n\n    c->rc = handle_command(io.data.header.bits.type, &io);"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "1. Validate the remaining length before every subtraction in both tuple loops: reject the packet when fewer than the 2-byte topic length plus the 1-byte QoS level (SUBSCRIBE) or fewer than the 2-byte topic length (UNSUBSCRIBE) remain, and reject it again when the declared topic length exceeds what is left after the topic length field has been consumed. Reject before reading the packet identifier when the declared length cannot hold it plus at least one complete tuple.\n2. Make the loop counter itself trustworthy: derive each iteration's bound from the bytes actually present in the packet rather than from the declared length alone, and fail closed on any packet whose contents do not exactly match its declared length.\n3. Remove the unreachable error branch or make the allocation helper return an error instead of terminating the process, so that a decode failure costs one connection rather than the whole broker.\n4. Reject and discard decoded packets that failed validation: the caller currently ignores the decoder's return code and dispatches the partially populated packet to the command handlers, which then operate on an empty tuple list.\n5. Bound the tuple count to the 16-bit field that stores it, and free the tuples already decoded when validation fails so that malformed packets cannot leak memory.\n6. Apply the same availability-before-subtraction rule to the remaining length arithmetic in the PUBLISH and CONNECT decoders, which use the same pattern.\n7. Add regression tests that feed each decoder truncated and length-inconsistent packets and assert a clean protocol error plus a live broker process.",
                "markdown": "1. Validate the remaining length before every subtraction in both tuple loops: reject the packet when fewer than the 2-byte topic length plus the 1-byte QoS level (SUBSCRIBE) or fewer than the 2-byte topic length (UNSUBSCRIBE) remain, and reject it again when the declared topic length exceeds what is left after the topic length field has been consumed. Reject before reading the packet identifier when the declared length cannot hold it plus at least one complete tuple.\n2. Make the loop counter itself trustworthy: derive each iteration's bound from the bytes actually present in the packet rather than from the declared length alone, and fail closed on any packet whose contents do not exactly match its declared length.\n3. Remove the unreachable error branch or make the allocation helper return an error instead of terminating the process, so that a decode failure costs one connection rather than the whole broker.\n4. Reject and discard decoded packets that failed validation: the caller currently ignores the decoder's return code and dispatches the partially populated packet to the command handlers, which then operate on an empty tuple list.\n5. Bound the tuple count to the 16-bit field that stores it, and free the tuples already decoded when validation fails so that malformed packets cannot leak memory.\n6. Apply the same availability-before-subtraction rule to the remaining length arithmetic in the PUBLISH and CONNECT decoders, which use the same pattern.\n7. Add regression tests that feed each decoder truncated and length-inconsistent packets and assert a clean protocol error plus a live broker process."
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "1496a8a2d98934d3e393675170e5c11cf35d7b7404ece2728c42c0bb9344f31d"
          },
          "properties": {
            "security-severity": "7.5",
            "strix_vuln_class_hash": "cf94f23c972594e78b6eb9d7668a39cbeb3d58615b6c1ce14a49dfc62341e80d",
            "strix": {
              "id": "vuln-0005",
              "severity": "high",
              "cvss": 7.5,
              "timestamp": "2026-11-17 10:19:53 UTC",
              "target": "sol MQTT broker, source snapshot (repository /workspace/source)",
              "endpoint": "MQTT SUBSCRIBE (0x82) and UNSUBSCRIBE (0xA2) packet decoders",
              "method": "TCP",
              "cwe": "CWE-191",
              "impact": "An unauthenticated network peer needs one TCP connection and 7 bytes - no CONNECT, no credentials - to take the broker down. On a build with the project's production flags the whole process dies with SIGSEGV within a fraction of a second (denial of service for every connected client). With the shipped 512 KB / 1 MB read-buffer configuration, and on builds where the allocator keeps up, the same packet instead produces an unbounded loop: resident memory grew from 52 MB to 965 MB within 0.5 s while one of the two event-loop threads stayed at ~95 % CPU, the connection stayed open, no diagnostic was produced, and the process ignored SIGTERM. In that state roughly half of the broker's event-loop capacity is lost permanently per malicious connection, and further connections exhaust memory until the process is killed. The same loop copies topic bytes from beyond the end of the read buffer, so callers that do not crash first perform unbounded out-of-bounds heap reads.",
              "technical_analysis": "The two decoders in `src/mqtt.c` consume the variable header and payload with a loop counter (`len`, a `usize`) that is the sender-declared Remaining Length. Every subtraction happens before the corresponding availability test, and the declared topic length is taken straight from the wire:\n\n```c title=src/mqtt.c startLineNumber=341 endLineNumber=358\n    usize i = 0;\n    for (; len > 0; ++i) {\n        /* Read length bytes of the first topic filter */\n        len -= sizeof(u16);\n\n        /* We have to make room for additional incoming tuples */\n        subscribe.tuples =\n            try_realloc(subscribe.tuples, (i + 1) * sizeof(*subscribe.tuples));\n        subscribe.tuples[i].topic_len =\n            unpack_string16(&buf, &subscribe.tuples[i].topic);\n\n        if (!subscribe.tuples[i].topic)\n            goto err;\n\n        len -= subscribe.tuples[i].topic_len;\n        subscribe.tuples[i].qos = unpack_integer(&buf, 'B');\n        len -= sizeof(u8);\n    }\n```\n\n`unpack_mqtt_unsubscribe` (`src/mqtt.c:386-401`) has the identical shape with a 2-tuple. `topic_len` is the u16 that `unpack_string16` has just read from the packet (`src/pack.c:420-425`), so the value subtracted at `src/mqtt.c:355` / `:400` is entirely attacker-controlled and is never compared with what is left of the packet.\n\nWith the 7-byte SUBSCRIBE `82 05 00 01 00 FF 41` the pre-loop bookkeeping leaves `len = 1` (`Remaining Length 5`, minus the 2-byte packet identifier, minus the 2-byte topic length). The declared topic length is `0x00FF = 255`, so `len = 1 - 255 = 18446744073709551362`, and `len > 0` remains true for ~2^64 iterations. The same packet with opcode `0xA2` reaches the identical arithmetic in `unpack_mqtt_unsubscribe`.\n\nEach iteration of the resulting loop has three effects:\n\n1. `try_realloc(subscribe.tuples, (i + 1) * sizeof(*subscribe.tuples))` grows the tuple array by 16 bytes per iteration, without bound and without regard to `max_memory`.\n2. `unpack_string16` allocates `topic_len + 1` bytes and copies `topic_len` bytes from `buf`, which advances by `2 + topic_len` (+1 for the QoS byte) per iteration, so the copy source leaves the per-client read buffer (`client->rbuf`, allocated with exactly `max_request_size` bytes at `src/server.c:392-394`) after about `max_request_size / 3` iterations and keeps walking the heap.\n3. Nothing is ever freed on this path: the tuple array and every topic string stay live, so resident memory grows by roughly `topic_len + 16` bytes per iteration.\n\nThe only exit from the loop is `if (!subscribe.tuples[i].topic) goto err;`, which is dead code because `unpack_bytes` (`src/pack.c:411-418`) calls `exit(EXIT_FAILURE)` on allocation failure instead of returning NULL.\n\nTwo smaller weaknesses in the same arithmetic: `src/mqtt.c:332` / `:377` subtract the 2-byte packet identifier before any check that `len >= 2`, and `subscribe.tuples_len = i` truncates an unbounded iteration count into a u16.\n\nThe pattern is present in the initial commit of the file (`git blame src/mqtt.c -L 342,357` attributes every line to `373d848`, 2024-12-12) and no later change bounded the loop.\n\nControl analysis: `recv_packet` limits only the *total* advertised packet to `max_request_size` (`src/server.c:551`); it never validates a field length against the bytes present. `unpack_string16` does not compare its declared length with the remaining packet length. Decoding happens in `process_message` (`src/server.c:865`) before any CONNECT or credential check, so the defect is reachable pre-authentication regardless of the `allow_anonymous` / `password_file` configuration.",
              "remediation_steps": "1. Validate the remaining length before every subtraction in both tuple loops: reject the packet when fewer than the 2-byte topic length plus the 1-byte QoS level (SUBSCRIBE) or fewer than the 2-byte topic length (UNSUBSCRIBE) remain, and reject it again when the declared topic length exceeds what is left after the topic length field has been consumed. Reject before reading the packet identifier when the declared length cannot hold it plus at least one complete tuple.\n2. Make the loop counter itself trustworthy: derive each iteration's bound from the bytes actually present in the packet rather than from the declared length alone, and fail closed on any packet whose contents do not exactly match its declared length.\n3. Remove the unreachable error branch or make the allocation helper return an error instead of terminating the process, so that a decode failure costs one connection rather than the whole broker.\n4. Reject and discard decoded packets that failed validation: the caller currently ignores the decoder's return code and dispatches the partially populated packet to the command handlers, which then operate on an empty tuple list.\n5. Bound the tuple count to the 16-bit field that stores it, and free the tuples already decoded when validation fails so that malformed packets cannot leak memory.\n6. Apply the same availability-before-subtraction rule to the remaining length arithmetic in the PUBLISH and CONNECT decoders, which use the same pattern.\n7. Add regression tests that feed each decoder truncated and length-inconsistent packets and assert a clean protocol error plus a live broker process.",
              "counterevidence": "The strongest case against the finding would be that the packet is rejected before the loop, that the loop is bounded by a check not visible at the call site, or that the crash is an artefact of instrumentation. None holds: the decoder receives `len = c->read - c->rpos` from `src/server.c:865` with no field validation anywhere upstream, the value evidenced in the faulting frame (`len=18446744073707446302`) is the wrapped counter rather than a bounded one, and the SIGSEGV was reproduced on a separate build using the project's production flags with no sanitizer, no stack protector and no test harness attached. The one genuine constraint is that the fault location moves with the allocator and buffer size: with a large buffer the loop can run long enough to look like a hang rather than a crash, and under an instrumented allocator it can be slowed enough that no report appears within a minute. That changes the observable symptom (crash versus CPU/memory exhaustion), not the reachability or the correctness of the trigger, and both symptoms are denial of service. A fair weaker reading is that confidentiality and integrity impact are not demonstrated: the out-of-bounds reads copy heap bytes into freshly allocated topic strings that are never returned to the attacker, which is why both are scored as none.",
              "confidence": "high",
              "severity_change_conditions": "Nothing would lower this below high: the packet is 7 bytes, unauthenticated and deterministic, and the process loss was reproduced on the project's own production flags. It would rise to critical only if the loop's out-of-bounds reads were shown to return heap contents to the attacker or to steer the walk towards a writable target, neither of which is demonstrated.",
              "fix_verification": "All work was done on a copy of the snapshot; the original tree was not modified. Build commands (project's own CMake, production branch plus a sanitizer variant):\n\n```\ncmake -S <copy> -B <copy>/build-dev -DDEBUG=0 -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n      -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS=\"-O2 -g\" -DCMAKE_C_FLAGS_RELEASE=\"-O2 -g\"\ncmake --build <copy>/build-dev --target sol -j8\ncmake -S <copy> -B <copy>/build-asan -DDEBUG=0 -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n      -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS=\"-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all\" \\\n      -DCMAKE_C_FLAGS_RELEASE=\"-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all\"\ncmake --build <copy>/build-asan --target sol -j8\n```\n\nBoth configurations compile with the project's `-Wall -Wunused -Werror -pedantic -std=c11` and produce no warning (gate 4, executed).\n\n**Gate 1 - applicability.** `diff -u` against the original tree contains only the three hunks above; `fix_before` blocks were copied from the original file and verified line-for-line against `src/mqtt.c:324-367`, `src/mqtt.c:369-410` and `src/server.c:865-867`.\n\n**Gate 2 - security closure (executed).** The same PoC, run against the patched binaries:\n\n```\nproduction-flags build, sub   : rss 46.6 MB -> 50.8 MB, 1 CPU tick over 6 s, alive after 6 s, exits on SIGTERM, no sanitizer report\nproduction-flags build, unsub : rss 47.1 MB -> 50.8 MB, 1 CPU tick over 6 s, alive after 6 s, exits on SIGTERM, no sanitizer report\nASan/UBSan build, 1 MB        : rss 52.9 MB -> 57.1 MB flat, 3 CPU ticks over 6 s, alive after 6 s, no sanitizer report\nASan/UBSan build, 4 KiB       : alive after 6 s, no sanitizer report\n```\n\nTrace through the patched code: `unpack_mqtt_subscribe` first rejects `len < 5`; with `len = 5` the first iteration finds `len = 3` after the packet id, subtracts the 2-byte topic length (`len = 1`), reads `topic_len = 255`, and the new test `topic_len > len` frees the topic and returns `-MQTT_ERR` without touching the loop counter again, so `len` can never wrap. `process_message` now consumes that return value, resets the client state machine and returns before `handle_command`, so the partially decoded packet is never dispatched (this also closed a variable-length-array-of-size-zero path in `subscribe_handler` that a zero-tuple SUBSCRIBE previously reached).\n\n**Gate 3 - bypass review (executed).** Other length fields in the same family: the per-iteration guard covers both subtract sites in both loops (2-byte topic length, topic, QoS byte / 2-byte topic length and topic); the initial guard covers the packet-identifier subtraction. Alternate malformed inputs tried against the patched broker: `82 02 00 01` and `A2 02 00 01` (zero tuples), `82 05 00 01 00 FF 41` and `A2 05 00 01 00 FF 41` (declared topic longer than the packet), each of which was rejected, left the broker serving PINGREQ on the same and on a new connection, and produced no sanitizer output. Sibling underflows of the same \"subtract before you check\" shape remain in the PUBLISH and CONNECT decoders; they are separate defects with their own reports and deliberately not folded into this change.\n\n**Gate 4 - preserved behaviour (executed).** `python3 test_smoke.py --port <patched instance>` reports `RESULT: 8/9` for both the production-flags and the sanitizer build, with CONNECT, SUBSCRIBE/SUBACK, cross-connection PUBLISH delivery, PINGREQ/PINGRESP, DISCONNECT and post-run liveness all passing. The single failure is `broker logged the connections`, which fails identically on the unpatched binary because the broker's log file is block-buffered while the process runs; after a clean shutdown of the patched instance the same log file contains the client identifiers, confirming the log path itself is intact. In addition, an explicit functional test run against the patched sanitizer build passes: a 3-tuple SUBSCRIBE returns a SUBACK with three granted QoS entries, all three subscriptions deliver their published message, and a SUBSCRIBE whose declared length does not cover its last tuple is rejected while a second client continues to be served.\n\n**Gap.** A valid multi-tuple UNSUBSCRIBE could not be exercised end-to-end on either build: the handler destroys the decoded packet and `process_message` destroys it a second time (a separate pre-existing defect), so the process aborts downstream of the decoder. Comparison against the unpatched binary shows the identical `free(): double free detected in tcache 2` outcome for the same packet, i.e. the patched decoder produces exactly the same downstream behaviour as before and the decoder change is not implicated.",
              "poc": {
                "description": "1. Build the broker from the snapshot twice: once with the project's production flags and once with AddressSanitizer/UBSan instrumentation for the memory-access view.\n2. Start an instance bound to 127.0.0.1 with `max_request_size 1MB` (the shipped-style configuration), and a second instance with `max_request_size 4096` so the read buffer is small.\n3. Open one TCP connection to the listening port and send the seven bytes `82 05 00 01 00 FF 41`. Do not send a CONNECT packet and do not authenticate.\n4. Against the production-flags instance, observe the process disappear within ~0.2 s (client sees EOF, exit status -11/SIGSEGV); a core dump shows the fault in `unpack_integer` reached from `unpack_string16` inside `unpack_mqtt_subscribe` with `len = 18446744073707446302`.\n5. Repeat step 3 with the seven bytes `A2 05 00 01 00 FF 41`; the fault moves one call site over, into `unpack_mqtt_unsubscribe` with the same wrapped `len`.\n6. Against the 4 KiB Read-buffer instance, observe the AddressSanitizer report `heap-buffer-overflow READ of size 1` at `src/pack.c:91` (`unpacku16`) reached from `unpack_mqtt_subscribe` at `src/mqtt.c:350`, about 0.2 s after the packet is sent - the loop has walked off the read buffer.\n7. Against the 1 MB instance, sample `/proc/<pid>/status` and `/proc/<pid>/stat` for six seconds: resident memory climbs from ~52 MB to ~950 MB within the first 0.5 s while the process accumulates CPU time on one thread, no sanitizer report is produced, the connection stays open, and SIGTERM is not honoured within four seconds.\n8. Confirm the packet is not merely a publishing-without-CONNECT artefact: the same broker keeps serving other clients normally until the looping packet arrives.",
                "script_available": true
              }
            }
          }
        },
        {
          "ruleId": "CWE-787",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Pre-auth heap out-of-bounds write from unbounded Remaining-Length decode and unchecked toread in recv_packet\n\nThe packet-framing code decodes the variable-length Remaining Length field without the four-byte limit the MQTT standard sets, and it does so on bytes it has not received, so continuation bits in stale read-buffer content keep the decode walking. The number of bytes consumed that way is then added to the attacker's declared length to decide how much more to read from the socket, without checking that total against the actual size of the per-client read buffer. The socket read therefore writes past the end of the buffer with bytes and a length the attacker chooses; sanitizer instrumentation reports heap-buffer-overflow writes of up to ~4 KB past a 64 KiB buffer and a decode walk that reads off the end of the allocation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/mqtt.c"
                },
                "region": {
                  "startLine": 129,
                  "endLine": 153,
                  "snippet": {
                    "text": "usize mqtt_decode_length(u8 *buf, unsigned *pos)\n{ ... do { c = *buf; ... } while ((c & 128) != 0); ... }"
                  }
                }
              },
              "message": {
                "text": "mqtt_decode_length: cap the walk at MAX_LEN_BYTES and at the bytes actually received"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/mqtt.h"
                },
                "region": {
                  "startLine": 275,
                  "endLine": 278,
                  "snippet": {
                    "text": "usize mqtt_decode_length(u8 *, unsigned *);"
                  }
                }
              },
              "message": {
                "text": "prototype: pass the number of length bytes that were received"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/server.c"
                },
                "region": {
                  "startLine": 540,
                  "endLine": 552,
                  "snippet": {
                    "text": "pktlen = mqtt_decode_length(c->rbuf + 1, &pos);\n        ...\n        if (pktlen > conf->max_request_size)\n            return -ERRMAXREQSIZE;"
                  }
                }
              },
              "message": {
                "text": "recv_packet: decode only received bytes and validate the total frame against the buffer allocation"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/server.c"
                },
                "region": {
                  "startLine": 475,
                  "endLine": 475,
                  "snippet": {
                    "text": "unsigned int pktlen = 0LL;"
                  }
                }
              },
              "message": {
                "text": "keep the decoded length in a 64-bit variable so it cannot be truncated"
              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "MQTT fixed-header / Remaining-Length framing (recv_packet)",
                  "kind": "endpoint"
                }
              ]
            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/mqtt.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 129,
                        "endLine": 153
                      },
                      "insertedContent": {
                        "text": "/*\n * Decode Remaining Length comprised of Variable Header and Payload if\n * present. It does not take into account the bytes for storing length. Refer\n * to MQTT v3.1.1 algorithm for the implementation suggestion.\n *\n * A Remaining Length is encoded on at most MAX_LEN_BYTES bytes and can only\n * be decoded from bytes that were actually received by the caller, so the\n * walk below stops as soon as either limit is reached instead of running\n * through stale buffer content.\n *\n * Returns (usize) -1 when the length field is not terminated within those\n * limits, in which case the caller must reject the packet.\n */\nusize mqtt_decode_length(u8 *buf, usize buflen, unsigned *pos)\n{\n\n    u8 c;\n    u64 multiplier = 1LL;\n    u64 value      = 0LL;\n    *pos           = 0;\n\n    do {\n        /*\n         * Never consume a length byte that was not received or that would go\n         * past the 4 bytes the standard allows to encode the length\n         */\n        if (*pos == MAX_LEN_BYTES || *pos == buflen)\n            return (usize) -1;\n\n        c = *buf;\n        value += (c & 127) * multiplier;\n        multiplier *= 128;\n        ++buf;\n        ++(*pos);\n    } while ((c & 128) != 0);\n\n    return value;\n}"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/mqtt.h"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 275,
                        "endLine": 278
                      },
                      "insertedContent": {
                        "text": "/*\n * The reverse of the encoding function, returns the value of the size decoded,\n * or (usize) -1 when the length field is not terminated within the 4 bytes the\n * standard allows or within the `buflen` bytes handed to it\n */\nusize mqtt_decode_length(u8 *, usize, unsigned *);"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/server.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 540,
                        "endLine": 552
                      },
                      "insertedContent": {
                        "text": "/*\n         * Read remaining length bytes which starts at byte 2 and can be long to\n         * 4 bytes based on the size stored, so byte 2-5 is dedicated to the\n         * packet length.\n         */\n        /*\n         * Only the length bytes that were actually received may be decoded:\n         * anything past them belongs to a previous packet or to a reused read\n         * buffer and must never be interpreted as part of this length field\n         */\n        pktlen = mqtt_decode_length(c->rbuf + 1, c->read - 1, &pos);\n\n        if (pktlen == (usize) -1)\n            return -ERRPACKETERR;\n\n        /*\n         * Set return code to -ERRMAXREQSIZE in case the whole frame exceeds the\n         * configuration limit `max_request_size`: the read buffer is allocated\n         * with exactly that size (see client_init), so the fixed header byte,\n         * the `pos` bytes used to encode the length and the remaining length\n         * itself must all fit in it. Testing `pktlen` alone would let the recv\n         * below write up to `pos` bytes past the end of the buffer.\n         */\n        if (pktlen + pos + 1 > conf->max_request_size)\n            return -ERRMAXREQSIZE;"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/server.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 475,
                        "endLine": 475
                      },
                      "insertedContent": {
                        "text": "usize pktlen = 0;"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "1. Bound the length decode: stop after four bytes have been consumed and report the packet as malformed when the field is not terminated by then, so the walk can never continue into stale or unrelated memory.\n2. Make the decode aware of what was actually received: pass the number of length bytes present in the read buffer and refuse to decode beyond it, instead of handing the decoder a pointer into a buffer that was only partially filled.\n3. Validate the whole frame before reading it: check that the fixed-header byte, the length-field bytes actually consumed and the decoded remaining length together do not exceed the size the read buffer was allocated with, and reject the packet otherwise. Keep the check as a single comparison on the total so no combination of a small decoded length and a long length field can pass.\n4. Keep the decoded length in a wide enough type: the decoder returns a 64-bit value, so holding it in a 32-bit variable silently truncates and can turn an oversized packet into an accepted one.\n5. Clear or overwrite the connection read buffer when a new connection is accepted, and reopen each framing state machine from a defined state, so leftover bytes from a previous packet or a recycled client object can never be interpreted as part of the next length field.\n6. Add regression tests that feed length fields with five or more continuation bytes, length fields whose last byte was never received, and frames whose total size is exactly the configured maximum, asserting a clean protocol error rather than an out-of-bounds access.",
                "markdown": "1. Bound the length decode: stop after four bytes have been consumed and report the packet as malformed when the field is not terminated by then, so the walk can never continue into stale or unrelated memory.\n2. Make the decode aware of what was actually received: pass the number of length bytes present in the read buffer and refuse to decode beyond it, instead of handing the decoder a pointer into a buffer that was only partially filled.\n3. Validate the whole frame before reading it: check that the fixed-header byte, the length-field bytes actually consumed and the decoded remaining length together do not exceed the size the read buffer was allocated with, and reject the packet otherwise. Keep the check as a single comparison on the total so no combination of a small decoded length and a long length field can pass.\n4. Keep the decoded length in a wide enough type: the decoder returns a 64-bit value, so holding it in a 32-bit variable silently truncates and can turn an oversized packet into an accepted one.\n5. Clear or overwrite the connection read buffer when a new connection is accepted, and reopen each framing state machine from a defined state, so leftover bytes from a previous packet or a recycled client object can never be interpreted as part of the next length field.\n6. Add regression tests that feed length fields with five or more continuation bytes, length fields whose last byte was never received, and frames whose total size is exactly the configured maximum, asserting a clean protocol error rather than an out-of-bounds access."
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "823ae191f2d7c458fa2f7779fc067f5ca8adeb6d5fecf7689d21a0bc01761ddf"
          },
          "properties": {
            "security-severity": "7.5",
            "strix_vuln_class_hash": "a107c171970fc515be8a19a80af1ee6d67a79f77ae092dba71df0d145a9af8a7",
            "strix": {
              "id": "vuln-0006",
              "severity": "high",
              "cvss": 7.5,
              "timestamp": "2026-11-17 10:21:03 UTC",
              "target": "sol MQTT broker, source snapshot (repository /workspace/source)",
              "endpoint": "MQTT fixed-header / Remaining-Length framing (recv_packet)",
              "method": "TCP",
              "cwe": "CWE-787",
              "impact": "An unauthenticated peer can make the broker write attacker-chosen bytes beyond the end of the per-client read buffer, which is a heap-corruption primitive on the request-framing path - the first code that runs for any connection, before CONNECT or authentication. The write length is derived from how far the attacker can drive the length-field walk into stale buffer content, so on the shipped 512 KB / 1 MB buffers the write can reach up to roughly a megabyte past the allocation; the demonstrated case writes 4001 bytes past a 64 KiB buffer (reported by AddressSanitizer as a 69533-byte out-of-bounds write into the heap). The same defect produces an out-of-bounds heap read of arbitrary distance (the decoder reads until it finds a byte without the continuation bit) and a framing desynchronisation where a client is left waiting on a packet the broker never finishes reading. What is proven is the write primitive, the out-of-bounds read and a sanitizer-detected process abort; conversion into controlled code execution was not demonstrated, and on the uninstrumented build the single overrun I tested did not by itself crash the process.",
              "technical_analysis": "Two defects combine in the framing path.\n\n**1. The length decode has no bound and reads bytes that were never received.** `src/mqtt.c:136-153`:\n\n```c title=src/mqtt.c startLineNumber=136 endLineNumber=153\nusize mqtt_decode_length(u8 *buf, unsigned *pos)\n{\n    u8 c;\n    u64 multiplier = 1LL;\n    u64 value      = 0LL;\n    *pos           = 0;\n\n    do {\n        c = *buf;\n        value += (c & 127) * multiplier;\n        multiplier *= 128;\n        ++buf;\n        ++(*pos);\n    } while ((c & 128) != 0);\n\n    return value;\n}\n```\n\nThe loop stops only on a byte whose bit 7 is clear. `MAX_LEN_BYTES` (defined at `src/mqtt.c:59`) is used exclusively by the encoder (`mqtt_encode_length`, `src/mqtt.c:112`); the decoder has no equivalent cap, and the comment above it records the gap as a TODO (\"Handle case where multiplier > 128 * 128 * 128\").\n\nIts caller violates the decoder's implicit precondition. `recv_packet` reads at most four bytes into `c->rbuf` (`src/server.c:484` for the first two, `src/server.c:530` for two more) and then calls the decoder on `c->rbuf + 1`, i.e. on `rbuf[1], rbuf[2], rbuf[3]` - three bytes that were received and `rbuf[4..]`, which were not. `rbuf` is not cleared between packets (`process_message` resets only `toread`, `read` and `rpos`), and `client_init` reuses a `struct client` from a pool without touching an already allocated `rbuf` (`src/server.c:392-394`), so `rbuf[4..]` holds either the previous packet's bytes on the same connection or bytes primed by an earlier connection that occupied the same pool slot. An attacker who first sends a normally framed packet whose body is a run of `0x80` bytes chooses that content.\n\n**2. `toread` is computed from the decoded length and the walk length, but only the decoded length is validated.** `src/server.c:545-575`:\n\n```c title=src/server.c startLineNumber=545 endLineNumber=575\n        pktlen = mqtt_decode_length(c->rbuf + 1, &pos);\n\n        /*\n         * Set return code to -ERRMAXREQSIZE in case the total packet len\n         * exceeds the configuration limit `max_request_size`\n         */\n        if (pktlen > conf->max_request_size)\n            return -ERRMAXREQSIZE;\n\n        /*\n         * Update the toread field for the client with the entire length of\n         * the current packet, which is comprehensive of packet length,\n         * bytes used to encode it and 1 byte for the header\n         */\n        c->rpos   = pos + 1;\n        c->toread = pktlen + pos + 1; // pos = bytes used to store length\n\n        /* Looks like we got an ACK packet, we're done reading */\n        if (pktlen <= 4)\n            goto exit;\n\n        c->status = WAITING_DATA;\n    }\n\n    nread = recv_data(&c->conn, c->rbuf + c->read, c->toread - c->read);\n```\n\n`c->rbuf` is allocated with exactly `conf->max_request_size` bytes (`src/server.c:392-394`, default `512KB` per `src/config.h:73`). The check on line 551 bounds `pktlen` only, while `toread = pktlen + pos + 1` includes the fixed header byte and the `pos` length bytes, and `pos` is whatever the unbound walk consumed - attacker-influenced through the stale content. Whenever `pktlen == max_request_size` (the comparison is strict `>`), `toread` exceeds the allocation by `pos + 1` bytes and the `recv` on line 575 writes that far past the end of the buffer. The observed arithmetic for a 64 KiB buffer is `pktlen = 65536`, `pos = 4000`, `toread = 69537`: a 4001-byte overwrite of whatever follows `rbuf` on the heap, carrying the attacker's socket bytes.\n\nTwo further details in the same code: `pktlen` is declared `unsigned int` while `mqtt_decode_length` returns `usize`, so a five-or-more-byte length field truncates the decoded value (this is reachable from the stale-walk primitive as well and is why the fix moves the variable to `usize`), and `pos` can grow to the length of the stale run, i.e. up to the size of the read buffer itself.\n\nRuntime confirmation on the uninstrumented build (measured under the debugger at the two source lines above):\n\n```\nBEFORE-DECODE: c->read=4 c->rpos=0 c->toread=0\nAT-RECV-575: c->toread=33102 c->read=4 rbuf_capacity=65536  (toread - read = 33098)   <- priming packet\nAT-RECV-575: c->toread=69537 c->read=4 rbuf_capacity=65536  (toread - read = 69533)   <- trigger\n```\n\nControls: none. The decoder cannot tell received bytes from stale ones, there is no cap on continuation bytes, and no code path re-checks `toread` against the buffer size. `max_request_size` therefore does not protect the read buffer at all. Framing runs inside `recv_packet` before any CONNECT or credential check, so the primitive is reachable pre-authentication with a bare TCP connection.",
              "remediation_steps": "1. Bound the length decode: stop after four bytes have been consumed and report the packet as malformed when the field is not terminated by then, so the walk can never continue into stale or unrelated memory.\n2. Make the decode aware of what was actually received: pass the number of length bytes present in the read buffer and refuse to decode beyond it, instead of handing the decoder a pointer into a buffer that was only partially filled.\n3. Validate the whole frame before reading it: check that the fixed-header byte, the length-field bytes actually consumed and the decoded remaining length together do not exceed the size the read buffer was allocated with, and reject the packet otherwise. Keep the check as a single comparison on the total so no combination of a small decoded length and a long length field can pass.\n4. Keep the decoded length in a wide enough type: the decoder returns a 64-bit value, so holding it in a 32-bit variable silently truncates and can turn an oversized packet into an accepted one.\n5. Clear or overwrite the connection read buffer when a new connection is accepted, and reopen each framing state machine from a defined state, so leftover bytes from a previous packet or a recycled client object can never be interpreted as part of the next length field.\n6. Add regression tests that feed length fields with five or more continuation bytes, length fields whose last byte was never received, and frames whose total size is exactly the configured maximum, asserting a clean protocol error rather than an out-of-bounds access.",
              "counterevidence": "The cases against this finding are that `max_request_size` already bounds the packet (it does not: it bounds only the decoded length, not the total the read is sized from), that the decoder cannot read past the received bytes because the socket buffer is zeroed (it is not: `rbuf` is allocated once per client and reused across packets and across pooled client objects, and the write happens before any such assumption could hold), and that the AddressSanitizer abort - not the corruption - is what constitutes the finding. The last point is the real constraint: the overrun was reproduced with instrumentation that aborts on the out-of-bounds access, and one subsequent attempt on the uninstrumented production build (sending the same 4001-byte overrun and then closing the connection so that the corrupted chunk is freed) did not crash the process. What remains demonstrated on the uninstrumented build is the out-of-bounds write itself, measured at the call site: `toread = 69537` against a 65536-byte allocation, with the recv requesting 69533 bytes at offset 4. I therefore scored integrity high and availability none rather than claiming a crash or code execution I did not observe. No validation, length cap or allocation check exists on this path - the search covered the decoder, its only call site, the size check and the two buffer allocations.",
              "confidence": "high",
              "confidence_rationale": "The framing arithmetic and the out-of-bounds access were reproduced on instrumented builds and the `toread` values were measured directly on the uninstrumented build at the exact source lines; the only unproven part is the conversion of the write primitive into a crash or control-flow change on the shipping build, which is reflected in the availability metric rather than in the confidence.",
              "severity_change_conditions": "A demonstrated crash, heap-metadata abort or control-flow influence from the same overrun on the uninstrumented production build would raise availability to high and the score to about 9.1 (critical); conversely, evidence that a fresh connection always starts with a zeroed read buffer and can never inherit primed bytes would reduce the practical overwrite length to the single-frame variant's five bytes and lower the integrity rating, though not below high severity.",
              "fix_verification": "All work was done on a copy of the snapshot; the original tree was not modified. Build commands (project's own CMake, production branch plus a sanitizer variant):\n\n```\ncmake -S <copy> -B <copy>/build-dev -DDEBUG=0 -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n      -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS=\"-O2 -g\" -DCMAKE_C_FLAGS_RELEASE=\"-O2 -g\"\ncmake --build <copy>/build-dev --target sol -j8\ncmake -S <copy> -B <copy>/build-asan -DDEBUG=0 -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n      -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS=\"-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all\" \\\n      -DCMAKE_C_FLAGS_RELEASE=\"-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all\"\ncmake --build <copy>/build-asan --target sol -j8\n```\n\nBoth configurations compile under the project's `-Wall -Wunused -Werror -pedantic -std=c11` with no warning (gate 4, executed).\n\n**Gate 1 - applicability.** `diff -u` against the original tree shows only the four hunks above; `fix_before` was copied from the original file and checked against `src/mqtt.c:129-153`, `src/mqtt.h:275-278`, `src/server.c:540-552` and `src/server.c:475`.\n\n**Gate 2 - security closure (executed).** All three PoC variants at both buffer sizes, against the patched sanitizer build:\n\n```\ntoread       65536  : alive True, connection reset, no sanitizer report\ntoread       1MB    : alive True, connection reset, no sanitizer report\nprime-walk   65536  : alive True, connection closed, no sanitizer report\nprime-walk   1MB    : alive True, connection closed, no sanitizer report\ntoread-mult  65536  : alive True, connection reset, no sanitizer report\ntoread-mult  1MB    : alive True, connection reset, no sanitizer report\n```\n\nTrace through the patched code: `recv_packet` now hands the decoder `c->read - 1`, i.e. exactly the number of length bytes present (three when four bytes have been received). The decoder returns `(usize) -1` as soon as it would consume a byte it was not given or a fifth byte, and the caller turns that into `-ERRPACKETERR` before `pos` or `toread` are computed, so `toread` can no longer be larger than the frame the attacker declared. The remaining size test compares the full frame (`pktlen + pos + 1`) with `max_request_size`, which is exactly the allocation size of `rbuf`, so the recv at `src/server.c:575` can no longer write past the buffer even for a maximum-sized frame. `pktlen` is now `usize`, so the 64-bit decode result is no longer truncated into a 32-bit variable.\n\n**Gate 3 - bypass review (executed).** Equivalent sinks: `mqtt_decode_length` has exactly one call site (`src/server.c:545`); `grep -rn mqtt_decode_length src/` confirms it, and the header prototype was updated with it. Alternate malicious inputs tried against the patched broker: `30 FF FF FF FF 7F` (five continuation bytes) - rejected, broker still answers PINGREQ on a fresh connection; `30 80 80 80 00` (four-byte prefix whose fourth byte was not received) - rejected, broker still serving; `30 80 80 C0` + maximum-sized body at both 64 KiB and 1 MiB - rejected. Legitimate framing still works across every prefix width: single-byte, two-byte and three-byte Remaining Length packets were all delivered (500-byte payload for the two-byte form, 1048547-byte payload filling a frame of exactly `max_request_size` bytes for the three-byte form). The sibling length arithmetic in the PUBLISH and CONNECT decoders is a different defect class with its own report and is not part of this change.\n\n**Gate 4 - preserved behaviour (executed).** `python3 test_smoke.py --port <patched instance>` reports `RESULT: 8/9` on both the production-flags and the sanitizer build; CONNECT, SUBSCRIBE/SUBACK, cross-connection PUBLISH delivery, PINGREQ/PINGRESP, DISCONNECT and post-run liveness all pass. The single failing check (`broker logged the connections`) fails identically on the unpatched binary because the broker's log file is block-buffered while running - after a clean shutdown the same instance's log contains the client identifiers.\n\n**Gap.** One behaviour change is intentional and should be reviewed: a frame whose total size exceeds `max_request_size` is now rejected, where previously a payload of exactly `max_request_size` was accepted and overran the buffer by `pos + 1` bytes. Deployments that legitimately need frames of exactly the configured maximum must raise `max_request_size` accordingly; the check now measures the whole frame rather than the payload alone, which matches how the buffer is allocated.",
              "poc": {
                "description": "1. Build the broker from the snapshot with AddressSanitizer/UBSan instrumentation, and separately with the project's production flags.\n2. Start an instance bound to 127.0.0.1 with `max_request_size 65536`.\n3. Open one TCP connection. First send a normally framed PUBLISH (`0x30`, a well-formed Remaining Length, a 2-byte topic length of `0x8080` and an all-`0x80` body) that fits the configured limit. This leaves the read buffer filled with continuation bytes.\n4. On the same connection, send the four bytes `30 80 80 84` followed by 69533 bytes. The 4th length byte is out of the received window, so the decoder continues into the primed buffer until the byte at offset 4000 terminates the walk, giving `pos = 4000` and `toread = 65536 + 4000 + 1 = 69537` on a 65536-byte buffer.\n5. Observe the sanitizer report: `heap-buffer-overflow ... WRITE of size 69533` with the stack `recv <- recv_bytes <- conn_recv <- recv_data <- recv_packet (src/server.c:575)`, destination one byte past the end of the read-buffer allocation.\n6. To observe the out-of-bounds read on its own, prime the read buffer with continuation bytes that extend to its end and then send `30 80 80 80`: the report is `heap-buffer-overflow ... READ of size 1` inside `mqtt_decode_length (src/mqtt.c:145)` from `recv_packet (src/server.c:545)`.\n7. To observe the same effect with a single frame and no priming, use a 1 MiB limit and send `30 80 80 C0` followed by 1048576 bytes: the declared length equals the limit and passes the size check, while `pos = 4` makes `toread = 1048581` against a 1048576-byte buffer.\n8. Confirm reachability without authentication by noting that no CONNECT packet is sent in any step, and that after the broker rejects the frame it continues to answer PINGREQ on a fresh connection.",
                "script_available": true
              }
            }
          }
        },
