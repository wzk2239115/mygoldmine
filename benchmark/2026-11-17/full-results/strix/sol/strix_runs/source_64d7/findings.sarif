            }
          }
        },
        {
          "ruleId": "strix-coverage/username-enumeration-via-response-time-oracle",
          "ruleIndex": 48,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Username enumeration via response-time oracle — Requires further review: Username lookup timing in connect_handler (known vs unknown user)\n\nConfirmed oracle: 150 CONNECTs per case. Known username 'alice' mean 2.39 ms / median 2.19 ms / p95 3.62 ms; unknown username mean 0.14 ms / median 0.09 ms / p95 0.20 ms - 17x with no overlap, because `if (!auth || !check_passwd(...))` only runs crypt() when the username exists. Confirmed but not filed per task instruction; feeds the brute-force item (attacker learns valid usernames, then guesses at 431/s per socket)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Username lookup timing in connect_handler (known vs unknown user)"
                }
              ]
            }
