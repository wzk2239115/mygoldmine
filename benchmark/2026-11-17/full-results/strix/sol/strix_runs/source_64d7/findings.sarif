              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "MQTT TCP listener — packet framing `recv_packet`, dispatch `process_message` / `mqtt_unpack`",
                  "kind": "endpoint"
                }
              ]
            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/handlers.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 61,
                        "endLine": 76
                      },
                      "insertedContent": {
                        "text": "/*\n * Command handler mapped usign their position paired with their type, one slot\n * per 4 bit MQTT packet type. A NULL entry marks a packet type the broker never\n * handles as an incoming packet: the reserved opcodes and the packets that only\n * travel server -> client.\n */\nstatic handler *handlers[MQTT_PACKET_TYPES] = {NULL,                /* 0  reserved */\n                                              connect_handler,      /* 1  CONNECT */\n                                              NULL,                 /* 2  CONNACK */\n                                              publish_handler,      /* 3  PUBLISH */\n                                              puback_handler,       /* 4  PUBACK */\n                                              pubrec_handler,       /* 5  PUBREC */\n                                              pubrel_handler,       /* 6  PUBREL */\n                                              pubcomp_handler,      /* 7  PUBCOMP */\n                                              subscribe_handler,    /* 8  SUBSCRIBE */\n                                              NULL,                 /* 9  SUBACK */\n                                              unsubscribe_handler,  /* 10 UNSUBSCRIBE */\n                                              NULL,                 /* 11 UNSUBACK */\n                                              pingreq_handler,      /* 12 PINGREQ */\n                                              NULL,                 /* 13 PINGRESP */\n                                              disconnect_handler,   /* 14 DISCONNECT */\n                                              NULL};                /* 15 reserved */"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/handlers.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 877,
                        "endLine": 880
                      },
                      "insertedContent": {
                        "text": "int handle_command(unsigned type, struct io_event *event)\n{\n    /*\n     * Bound the lookup and reject the packet types the broker does not\n     * implement before dereferencing the table slot: an unchecked lookup\n     * turns a single attacker-chosen opcode into a call through NULL.\n     */\n    if (type >= (unsigned)MQTT_PACKET_TYPES || handlers[type] == NULL)\n        return -ERRPACKETERR;\n    return handlers[type](event);\n}"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/mqtt.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 68,
                        "endLine": 82
                      },
                      "insertedContent": {
                        "text": "/*\n * Unpack functions mapping unpacking_handlers positioned in the array based\n * on message type, one slot per 4 bit MQTT packet type. A NULL entry means the\n * packet carries no variable header nor payload (PINGREQ, DISCONNECT) or that\n * the type is not a client -> server packet at all (CONNACK, SUBACK, UNSUBACK,\n * PINGRESP and the reserved opcodes).\n */\nstatic mqtt_unpack_handler *unpack_handlers[MQTT_PACKET_TYPES] = {\n    NULL,                    /* 0  reserved */\n    unpack_mqtt_connect,     /* 1  CONNECT */\n    NULL,                    /* 2  CONNACK */\n    unpack_mqtt_publish,     /* 3  PUBLISH */\n    unpack_mqtt_ack,         /* 4  PUBACK */\n    unpack_mqtt_ack,         /* 5  PUBREC */\n    unpack_mqtt_ack,         /* 6  PUBREL */\n    unpack_mqtt_ack,         /* 7  PUBCOMP */\n    unpack_mqtt_subscribe,   /* 8  SUBSCRIBE */\n    NULL,                    /* 9  SUBACK */\n    unpack_mqtt_unsubscribe, /* 10 UNSUBSCRIBE */\n    NULL,                    /* 11 UNSUBACK */\n    NULL,                    /* 12 PINGREQ */\n    NULL,                    /* 13 PINGRESP */\n    NULL,                    /* 14 DISCONNECT */\n    NULL                     /* 15 reserved */\n};"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/mqtt.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 418,
                        "endLine": 437
                      },
                      "insertedContent": {
                        "text": "/*\n * Tell whether a packet type may legitimately be received from a client.\n * CONNACK, SUBACK, UNSUBACK and PINGRESP only ever travel server -> client and\n * the 0 and 15 opcodes are reserved, so a broker must never act on them.\n */\nint mqtt_opcode_is_client_packet(u8 type)\n{\n    switch (type) {\n    case CONNECT:\n    case PUBLISH:\n    case PUBACK:\n    case PUBREC:\n    case PUBREL:\n    case PUBCOMP:\n    case SUBSCRIBE:\n    case UNSUBSCRIBE:\n    case PINGREQ:\n    case DISCONNECT:\n        return 1;\n    default:\n        return 0;\n    }\n}\n\n/*\n * Main unpacking function entry point. Call the correct unpacking function\n * through a dispatch table\n */\nint mqtt_unpack(u8 *buf, struct mqtt_packet *pkt, u8 byte, usize len)\n{\n    u8 type = byte >> 4;\n\n    pkt->header = (union mqtt_header){.byte = byte};\n\n    /* Reject reserved opcodes and the server -> client only packet types */\n    if (!mqtt_opcode_is_client_packet(type))\n        return -MQTT_ERR;\n\n    /* PINGREQ and DISCONNECT have no variable header nor payload */\n    if (type == PINGREQ || type == DISCONNECT)\n        return MQTT_OK;\n\n    /* Bound the table lookup before calling through the selected slot */\n    if (type >= MQTT_PACKET_TYPES || unpack_handlers[type] == NULL)\n        return -MQTT_ERR;\n\n    return unpack_handlers[type](buf, pkt, len);\n}"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/mqtt.h"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 64,
                        "endLine": 65
                      },
                      "insertedContent": {
                        "text": "/* Message types */\n#define MQTT_PACKET_TYPES                  16 // 4 bit opcode space\n\nenum packet_type {"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/mqtt.h"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 284,
                        "endLine": 284
                      },
                      "insertedContent": {
                        "text": "int mqtt_unpack(u8 *, struct mqtt_packet *, u8, usize);\n\n/*\n * Tell whether a packet type may legitimately be received from a client, i.e.\n * it is implemented by the broker and is not a server -> client only packet\n */\nint mqtt_opcode_is_client_packet(u8);"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/server.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 508,
                        "endLine": 513
                      },
                      "insertedContent": {
                        "text": "/*\n             * Check for OPCODE, if an unknown OPCODE is received, or a packet\n             * type the broker does not implement as an incoming packet, return\n             * an error: CONNACK, SUBACK, UNSUBACK, PINGRESP and the reserved\n             * opcodes must never reach the dispatch tables\n             */\n            if (DISCONNECT < opcode || CONNECT > opcode ||\n                !mqtt_opcode_is_client_packet(opcode))\n                return -ERRPACKETERR;"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "Reject packet types the broker does not implement before they reach any dispatch table, and make both dispatch sites defensive. Concretely: introduce a single predicate that enumerates the packet types a client may send (CONNECT, PUBLISH, PUBACK, PUBREC, PUBREL, PUBCOMP, SUBSCRIBE, UNSUBSCRIBE, PINGREQ, DISCONNECT) and call it from the framing gate so CONNACK, SUBACK, UNSUBACK, PINGRESP and the reserved opcodes are rejected with a protocol error and the connection closed. Size both the decoder and the command handler tables for the whole 4-bit opcode space (16 entries) with an explicit, commented slot per type so a missing entry is deliberate rather than accidental, and make both lookup sites bound the index and treat a NULL entry as a protocol error instead of calling through it. As defence in depth, consider having the decoder return an error that the caller acts on, rather than ignoring the decode result, so a future table gap cannot silently fall through to a handler that was never designed to run for that packet type.",
                "markdown": "Reject packet types the broker does not implement before they reach any dispatch table, and make both dispatch sites defensive. Concretely: introduce a single predicate that enumerates the packet types a client may send (CONNECT, PUBLISH, PUBACK, PUBREC, PUBREL, PUBCOMP, SUBSCRIBE, UNSUBSCRIBE, PINGREQ, DISCONNECT) and call it from the framing gate so CONNACK, SUBACK, UNSUBACK, PINGRESP and the reserved opcodes are rejected with a protocol error and the connection closed. Size both the decoder and the command handler tables for the whole 4-bit opcode space (16 entries) with an explicit, commented slot per type so a missing entry is deliberate rather than accidental, and make both lookup sites bound the index and treat a NULL entry as a protocol error instead of calling through it. As defence in depth, consider having the decoder return an error that the caller acts on, rather than ignoring the decode result, so a future table gap cannot silently fall through to a handler that was never designed to run for that packet type."
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "f0a34c9fdd29cfc2265b61d5df6a9eecad71603a39e1f35faad48b578a9cb109"
          },
          "properties": {
            "security-severity": "7.5",
            "strix_vuln_class_hash": "cc5ac77e0fef5f1a4a60aa749a555e31f6a4625b7dd4c522215f9882162548aa",
            "strix": {
              "id": "vuln-0003",
              "severity": "high",
              "cvss": 7.5,
              "timestamp": "2026-11-17 10:14:02 UTC",
              "target": "sol MQTT v3.1.1 broker (C source snapshot, `src/`)",
              "endpoint": "MQTT TCP listener — packet framing `recv_packet`, dispatch `process_message` / `mqtt_unpack`",
              "method": "MQTT (raw TCP)",
              "cwe": "CWE-476",
              "impact": "**Unauthenticated, zero-interaction availability loss for the whole broker process.** A single two-byte packet sent on a fresh TCP connection — no CONNECT, no credentials, no prior state — terminates the listening daemon (SIGSEGV). Every connected client is dropped, in-flight QoS state and the in-memory retained-message store are lost, and the broker stays down until something outside the process restarts it. The same death is reachable from four distinct packet types and through both dispatch tables, so filtering a single opcode does not mitigate it.\n\nNo confidentiality or integrity impact is claimed: the crash address is exactly `0x0` and the call target is not attacker-controlled, so no read/write primitive or control-flow influence was demonstrated. The demonstrated effect is process termination only (`C:N` / `I:N` / `A:H`).",
              "technical_analysis": "## Attacker-reachable path\n\n`recv_packet` admits any opcode in the CONNECT..DISCONNECT range and never checks whether the broker implements that packet type as an incoming packet:\n\n```c title=src/server.c startLineNumber=505 endLineNumber=523\n        if (c->read == 2) {\n            opcode = *c->rbuf >> 4;\n\n            /*\n             * Check for OPCODE, if an unknown OPCODE is received return an\n             * error\n             */\n            if (DISCONNECT < opcode || CONNECT > opcode)\n                return -ERRPACKETERR;\n\n            /*\n             * We have a PINGRESP/PINGREQ or a DISCONNECT packet, we're done\n             * here\n             */\n            if (opcode > UNSUBSCRIBE) {\n                c->rpos   = 2;\n                c->toread = c->read;\n                goto exit;\n            }\n        }\n```\n\nTwo of the four types of interest (PINGRESP = 13, UNSUBACK = 11) are additionally classified as \"no payload\" packets, so the frame is accepted after only two bytes are read, with `read == toread == 2`.\n\n`process_message` then decodes and dispatches with no regard for whether the type is legal from a client:\n\n```c title=src/server.c startLineNumber=858 endLineNumber=867\nstatic void process_message(struct ev_ctx *ctx, struct client *c)\n{\n    struct io_event io = {.client = c};\n    /*\n     * Unpack received bytes into a mqtt_packet structure and execute the\n     * correct handler based on the type of the operation.\n     */\n    mqtt_unpack(c->rbuf + c->rpos, &io.data, *c->rbuf, c->read - c->rpos);\n    c->toread = c->read = c->rpos = 0;\n    c->rc = handle_command(io.data.header.bits.type, &io);\n```\n\n## Root cause 1 — unchecked command dispatch table\n\nThe command handler table is declared with 15 entries and NULL placeholders for CONNACK (2), SUBACK (9), UNSUBACK (11) and PINGRESP (13):\n\n```c title=src/handlers.c startLineNumber=61 endLineNumber=76\n/* Command handler mapped usign their position paired with their type */\nstatic handler *handlers[15] = {NULL,\n                                connect_handler,\n                                NULL,\n                                publish_handler,\n                                ...\n                                NULL,\n                                disconnect_handler};\n```\n\nand the only public dispatch entry point indexes it and calls the result:\n\n```c title=src/handlers.c startLineNumber=877 endLineNumber=880\nint handle_command(unsigned type, struct io_event *event)\n{\n    return handlers[type](event);\n}\n```\n\nThere is no range check (the opcode is a 4-bit field, so `type == 15` would read one element past a 15-entry table) and no NULL check. `D0 00` consequently performs `call *handlers[13]` with a NULL target: the faulting instruction pointer is exactly `0x0` and `rax` holds the selected index, `0xd`.\n\n## Root cause 2 — out-of-bounds decoder dispatch table\n\nThe decoder table has only eleven entries, ending at UNSUBSCRIBE (10):\n\n```c title=src/mqtt.c startLineNumber=68 endLineNumber=82\n/*\n * Unpack functions mapping unpacking_handlers positioned in the array based\n * on message type\n */\nstatic mqtt_unpack_handler *unpack_handlers[11] = {NULL,\n                                                   unpack_mqtt_connect,\n                                                   NULL,\n                                                   unpack_mqtt_publish,\n                                                   unpack_mqtt_ack,\n                                                   ...\n                                                   unpack_mqtt_unsubscribe};\n```\n\n`mqtt_unpack` only short-circuits types 12..14, so UNSUBACK (11) is used as an index into that 11-element array — an out-of-bounds read of a function pointer that is then called — while CONNACK (2) and SUBACK (9) call the NULL slots:\n\n```c title=src/mqtt.c startLineNumber=422 endLineNumber=437\nint mqtt_unpack(u8 *buf, struct mqtt_packet *pkt, u8 byte, usize len)\n{\n\n    int rc      = MQTT_OK;\n    u8 type     = byte >> 4;\n\n    pkt->header = (union mqtt_header){.byte = byte};\n\n    /* Call the appropriate unpack handler based on the message type */\n    if (type >= PINGREQ && type <= DISCONNECT)\n        return rc;\n\n    rc = unpack_handlers[type](buf, pkt, len);\n\n    return rc;\n}\n```\n\n## Reachability and preconditions\n\nNone beyond the ability to open a TCP connection. Decoding and dispatch both run inside `process_message` before `connect_handler` evaluates `allow_anonymous` or any credential, so the flaw is reachable with `allow_anonymous false` and no CONNECT at all (verified). The packet also works after a successful CONNECT, so authenticating does not protect against it.\n\nThe two dispatch layers have to be fixed together: rejecting only type 11 leaves types 2, 9 and 13 live, and fixing only the decoder leaves the `handlers[]` holes reachable through the types the decoder does not unpack (the PINGREQ/DISCONNECT paths and, for type 13, the short-packet path).",
              "remediation_steps": "Reject packet types the broker does not implement before they reach any dispatch table, and make both dispatch sites defensive. Concretely: introduce a single predicate that enumerates the packet types a client may send (CONNECT, PUBLISH, PUBACK, PUBREC, PUBREL, PUBCOMP, SUBSCRIBE, UNSUBSCRIBE, PINGREQ, DISCONNECT) and call it from the framing gate so CONNACK, SUBACK, UNSUBACK, PINGRESP and the reserved opcodes are rejected with a protocol error and the connection closed. Size both the decoder and the command handler tables for the whole 4-bit opcode space (16 entries) with an explicit, commented slot per type so a missing entry is deliberate rather than accidental, and make both lookup sites bound the index and treat a NULL entry as a protocol error instead of calling through it. As defence in depth, consider having the decoder return an error that the caller acts on, rather than ignoring the decode result, so a future table gap cannot silently fall through to a handler that was never designed to run for that packet type.",
              "counterevidence": "Looked for a control that would filter these frames before dispatch and found none: the only pre-dispatch validation is the opcode range check at `src/server.c:512` (`DISCONNECT < opcode || CONNECT > opcode`), which passes every type used here; `max_request_size` bounds only the declared Remaining Length; and neither `handle_command` nor `mqtt_unpack` checks the slot before calling it. Decoding and dispatch run before `connect_handler`, so `allow_anonymous`/password configuration does not run first — verified dynamically against a broker with `allow_anonymous false`, which died identically with no credentials supplied. A CONNECT beforehand does not help (verified: same crash after `CONNACK 20 02 00 00`).\n\nThe strongest remaining argument against severity is that this is only a crash: the faulting `pc` is exactly `0x0`, `rax` holds the opcode index rather than attacker data, and for type 11 the out-of-bounds slot contains a linker-determined value, so no controlled call target or write primitive was demonstrated. That is why the rating is availability-only. The service itself is not otherwise broken — the control packet `C0 00` is answered correctly on the same build and the same broker instance.",
              "confidence": "high",
              "confidence_rationale": "Reproduced deterministically against both the sanitizer build and the plain optimized build, pre-authentication and post-CONNECT, with an in-band negative control and a rebuilt patch that closes all four cases.",
              "severity_change_conditions": "Evidence that the broker is the only instance behind the service and has no supervisor or auto-restart would raise this from a transient crash to a sustained outage; conversely, confirmed sub-second automatic restart would lower the practical impact. Evidence that an attacker can influence the contents of the out-of-bounds table slot reached by type 11 would raise it to a control-flow hijack and add integrity impact.",
              "fix_verification": "All work was done in a private copy of the tree; the reported tree was not modified. Both build variants were rebuilt from scratch with the project's production flags (`DEBUG=0` implies `-O3 -Wall -Werror -pedantic -std=c11`), so the new code compiled warning-free under `-Werror`.\n\n**Gate 1 — security closure (executed).** Rebuilt `build-asan` (`-O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all`) and `build-dev` (`-O2 -g`) with `cmake -S . -B <dir> -DDEBUG=0 -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS=...` then `cmake --build <dir> --target sol`; both clean. Re-ran the reproduction cases against the patched binaries:\n\n```\npatched ASan : pingresp  sent d0 00        reply <peer closed>  broker SURVIVED (no sanitizer report)\npatched ASan : unsuback  sent b0 00        reply <peer closed>  broker SURVIVED\npatched ASan : suback    sent 90 00 00 00  reply <reset>        broker SURVIVED\npatched ASan : connack   sent 20 00 00 00  reply <reset>        broker SURVIVED\npatched ASan : pingreq   sent c0 00        reply d0 00          broker SURVIVED\npatched dev  : the same four crash payloads -> broker SURVIVED, pingreq answered d0 00\npatched dev  : allow_anonymous=false, d0 00 -> broker ALIVE\n```\n\nThe source-to-sink path now fails at the gate: `recv_packet` returns `-ERRPACKETERR` for opcodes 0/2/9/11/13/15 before `process_message` is reached, and even if a future path skipped the gate, `mqtt_unpack` and `handle_command` both bound the index and return an error instead of calling a NULL or out-of-bounds slot.\n\n**Gate 2 — bypass review (executed).** Re-read the diff against the call sites: `handle_command` has one caller (`process_message`, which takes `type` from a 4-bit field), `mqtt_unpack` has one caller (`process_message`), `mqtt_opcode_is_client_packet` has two. Alternate input classes were sprayed at the patched broker, one connection per payload, sampling liveness after each:\n\n```\ntype 0 reserved            00 00 00 00                                     broker alive\ntype 2 CONNACK             20 00 00 00                                     broker alive\ntype 2 CONNACK, RL=2       20 02 00 00                                     broker alive\ntype 9 SUBACK              90 00 00 00                                     broker alive\ntype 9 SUBACK, RL=2        90 02 00 01                                     broker alive\ntype 11 UNSUBACK, RL=0     B0 00                                           broker alive\ntype 11 UNSUBACK, RL=12    B0 0C 00 02 00 08 62 63 2f 74 6f 70 69 63       broker alive\ntype 13 PINGRESP, RL=0     D0 00                                           broker alive\ntype 13 PINGRESP, RL=5     D0 05 41 41 41 41 41                            broker alive\ntype 15 reserved           F0 00                                           broker alive\ntype 15 reserved, RL=4     F0 04 41 41 41 41                               broker alive\ntype 12 PINGREQ (control)  C0 00                                           reply d0 00, broker alive\nRESULT: PASS (0 fatal payloads), no sanitizer report\n```\n\nThe same corpus against the unpatched build dies on the second payload (`20 00 00 00`, broker DEAD), which confirms the corpus exercises the defect and that the patch, not the test setup, is what stops it. `pack_handlers[13]` was reviewed as the sibling write-side table: it is only reached from `mqtt_pack`/`mqtt_pack_mono` with types chosen by broker code, never from decoded input, so it needs no change here.\n\n**Gate 3 — preserved behaviour (executed, one documented gap).** The end-to-end smoke suite against both patched builds: `RESULT: PASS (7/7 checks)` — anonymous CONNECT/CONNACK, SUBSCRIBE/SUBACK, PUBLISH delivery to a second connection, PINGREQ to PINGRESP, clean DISCONNECT, and the broker still accepting afterwards. A dedicated flow check produced:\n\n```\nQoS1 publisher ack : 40 00 07\nQoS1 subscriber    : PUBLISH mid=1, PUBACK sent, PINGREQ after PUBACK -> d0\nQoS2 publisher     : PUBREC 50 00 05 -> PUBREL 62 02 00 05 -> PUBCOMP 70 00 05\nQoS2 subscriber    : PUBLISH mid=1 -> PUBREC, PUBREL 62 00 01, PUBCOMP, PINGREQ -> d0\nbroker after the flows: ALIVE, RESULT: PASS\n```\n\n**Gap:** the UNSUBSCRIBE path cannot serve as a positive control because it kills the broker on the *unpatched* tree as well — the decoded packet is destroyed in `unsubscribe_handler` and again in `process_message`, so the process aborts before the UNSUBACK is written. Both trees behave identically on the same 14-byte packet (SIGABRT), which shows the dispatch change did not alter UNSUBSCRIBE dispatch (the type still reaches `unsubscribe_handler` and packs the UNSUBACK), but end-to-end UNSUBACK delivery remains unverified here and depends on that separate double-free defect being fixed.\n\n**Gate 4 — repository checks (executed).** `cmake --build build-dev --target sol_test` built and ran the upstream unit suite: `tests run: 13 tests passed: 13`. Both `sol` variants built with `-Werror` and no diagnostics. Not run: `tests/integration/` (it needs an external MQTT client library that is not available in this environment) — recorded as a gap rather than claimed as passing.",
              "poc": {
                "description": "1. Start the `sol` broker on a loopback port from the ASan/UBSan build (`build-asan/sol`) or the plain optimized build (`build-dev/sol`).\n2. Open a TCP connection to the listener and send the two bytes `D0 00` (fixed header: type 13 PINGRESP, flags 0; Remaining Length 0). Do not send a CONNECT first.\n3. Observe the connection close without a reply.\n4. Observe the broker terminate: AddressSanitizer reports `SEGV on unknown address 0x000000000000 (pc 0x000000000000)` with the top frame in `process_message` (`src/server.c:867`); the non-instrumented build dies with signal 11.\n5. Repeat with `B0 00` (UNSUBACK, type 11) to reach the out-of-bounds decoder table entry, and with `90 00 00 00` (SUBACK, type 9) and `20 00 00 00` (CONNACK, type 2) to reach NULL decoder slots; each terminates the broker.\n6. Control: repeat with `C0 00` (PINGREQ, type 12) — the broker answers `D0 00` and keeps serving.\n7. Repeat step 2 against a broker started with `allow_anonymous false` without supplying any credentials, to confirm the packet is processed before authentication.\n8. Apply the patch, rebuild, and repeat steps 2, 5 and 6: every case now closes only the offending connection and the broker stays up.",
                "script_available": true
              }
            }
          }
        },
        {
          "ruleId": "CWE-476",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Pre-auth process kill: PUBACK/PUBCOMP for an unallocated packet id DECREFs a NULL in-flight packet\n\nA four-byte PUBACK or PUBCOMP naming a packet identifier the broker never allocated terminates the `sol` broker. The ACK handlers take the identifier straight from the wire, index the per-session in-flight table and decrement the reference count of the packet stored there without checking that the session exists or that the slot holds a live packet; for any unallocated identifier that slot is NULL, so the reference-count write faults. No CONNECT, credentials or prior state are required, and re-sending a PUBACK for an identifier that was already acknowledged — ordinary QoS 1 client behaviour — triggers the same crash."
          },
