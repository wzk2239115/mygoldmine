            {
              "id": "strix-coverage/decoder-primitives-allocation-copy-helpers-and-their-failure-modes",
              "name": "Decoder primitives — allocation/copy helpers and their failure modes",
              "shortDescription": {
                "text": "Coverage: Decoder primitives — allocation/copy helpers and their failure modes"
