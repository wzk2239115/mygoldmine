        {
          "ruleId": "strix-coverage/authentication-bypass-flag-emptiness-prefix-case-length-nul-hash-as-password",
          "ruleIndex": 44,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Authentication bypass (flag/emptiness/prefix/case/length/NUL/hash-as-password) — Ruled out: CONNECT credential check (src/handlers.c connect_handler + src/util.c check_passwd)\n\nControl pair observed: alice/secret123 -> CONNACK 20 02 00 00 then SUBACK 90 03 00 07 00 + PUBACK; alice/wrongpass -> 20 02 00 04. Ten bypass variants all rc=4: password flag clear, zero-length password, password flag without bytes, empty username, hash-as-password, unknown user, alic/alice2/Alice/ALICE/\"alice \", 60KB username and 60KB password (no ASan report). Control that blocks them: both-flag gate `if (c->bits.username==0 || c->bits.password==0) goto bad_auth` plus exact uthash HASH_FIND_STR lookup (memcmp, not prefix/case tolerant) plus crypt comparison, and it runs before cc->connected=true on every path."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "CONNECT credential check (src/handlers.c connect_handler + src/util.c check_passwd)"
                }
