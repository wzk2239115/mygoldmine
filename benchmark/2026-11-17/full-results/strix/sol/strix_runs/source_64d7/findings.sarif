              "risk_area": "Authentication bypass (flag/emptiness/prefix/case/length/NUL/hash-as-password)",
              "surface": "CONNECT credential check (src/handlers.c connect_handler + src/util.c check_passwd)",
              "recorded_by": "Auth and TLS Validator",
