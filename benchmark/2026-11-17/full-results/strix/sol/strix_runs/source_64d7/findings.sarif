        {
          "ruleId": "strix-coverage/decoded-pointer-lifetime-ownership",
          "ruleIndex": 11,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Decoded-pointer lifetime / ownership — Ruled out: src/mqtt.c mqtt_packet_alloc + mqtt_packet_destroy (per-opcode free paths)\n\nCONFIRMED BY TRACE (note fb95db R6): mqtt_packet_alloc (mqtt.c:685-692) is never used on the decode path (io.data is a stack value), mqtt_packet_destroy is called once per decoded non-PUBLISH packet from server.c:880/895 — the single exception is UNSUBSCRIBE which also destroys it itself at handlers.c:676 (double free, tracked as note 96c97e). mqtt_unsubscribe/mqtt_subscribe are prefix-compatible so the shared destroy branch is layout-safe, and PUBLISH ownership is deliberately transferred to mqtt_packet_alloc'd copies via refcount (handlers.c:742-755)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "src/mqtt.c mqtt_packet_alloc + mqtt_packet_destroy (per-opcode free paths)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
