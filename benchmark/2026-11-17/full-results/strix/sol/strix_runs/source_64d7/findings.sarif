        },
        {
          "ruleId": "strix-coverage/mutual-tls-client-certificate-verification-bypass",
          "ruleIndex": 52,
          "kind": "notApplicable",
          "level": "none",
          "message": {
            "text": "Mutual TLS / client certificate verification bypass — Not applicable: TLS peer verification (SSL_VERIFY_NONE, network.c:362-391)\n\nSSL_CTX_set_verify(ctx, SSL_VERIFY_NONE, ...) at network.c:373 means no CertificateRequest is ever sent: s_client reports \"No client certificate CA names sent\" and the handshake succeeds identically with no client cert and with a rogue self-signed client cert (Verify return code 0 in both). cafile is loaded via SSL_CTX_load_verify_locations but is never used to authenticate a peer. The risk \"defeat client-certificate authentication\" therefore cannot apply - there is no such control to defeat; recorded as a posture gap for operators who set cafile expecting mTLS."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "TLS peer verification (SSL_VERIFY_NONE, network.c:362-391)"
                }
