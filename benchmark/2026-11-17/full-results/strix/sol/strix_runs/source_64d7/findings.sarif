      "results": [
        {
          "ruleId": "CWE-787",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Pre-authentication heap buffer overflow via unbounded appends to the per-client MQTT write buffer\n\nThe broker allocates each client's write buffer at exactly `max_request_size` bytes but no code path ever checks whether the next packet fits, so protocol messages larger than the remaining space are written past the end of the heap allocation. A single unauthenticated SUBSCRIBE that replays retained messages - or a session resume, or a QoS retransmit - overruns the buffer with bytes the attacker chose, and the shipped configuration crashes. The same unchecked append exists at twelve further write sites, so the buffer can also be overrun by ordinary protocol traffic once it is nearly full."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/server.h"
                },
                "region": {
                  "startLine": 142,
                  "endLine": 142,
                  "snippet": {
                    "text": "void enqueue_event_write(const struct client *);"
                  }
                }
              },
              "message": {
                "text": "Declare the bounded write-buffer append helper"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/server.c"
                },
                "region": {
                  "startLine": 376,
                  "endLine": 380,
                  "snippet": {
                    "text": "/*\n * All clients are pre-allocated at the start of the server, but their buffers\n * (read and write) are not, they're lazily allocated with this function, meant\n * to be called on the accept callback\n */"
                  }
                }
              },
              "message": {
                "text": "Add client_wbuf_reserve(): the single place that enforces towrite + len <= max_request_size"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 227,
                  "endLine": 228,
                  "snippet": {
                    "text": "mqtt_pack(pkt, sc->wbuf + sc->towrite);\n        sc->towrite += len;"
                  }
                }
              },
              "message": {
                "text": "Publish fan-out: bound the per-subscriber PUBLISH append"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 316,
                  "endLine": 317,
                  "snippet": {
                    "text": "mqtt_pack(&response, c->wbuf + c->towrite);\n    c->towrite += MQTT_ACK_LEN;"
                  }
                }
              },
              "message": {
                "text": "CONNACK append: bound against max_request_size"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 330,
                  "endLine": 337,
                  "snippet": {
                    "text": "// TODO check for write buffer size exceed\n        if (list_size(c->session->outgoing_msgs) > 0) {\n            size_t len = 0;\n            list_foreach(item, c->session->outgoing_msgs)\n            {\n                len = mqtt_size(item->data, NULL);\n                mqtt_pack(item->data, c->wbuf + c->towrite);\n                c->towrite += len;"
                  }
                }
              },
              "message": {
                "text": "Session-resume flush: bound every queued message (removes the TODO)"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 617,
                  "endLine": 618,
                  "snippet": {
                    "text": "memcpy(c->wbuf + c->towrite, t->retained_msg, len);\n            c->towrite += len;"
                  }
                }
              },
              "message": {
                "text": "Retained-message replay: bound the attacker-sized memcpy (primary sink)"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 633,
                  "endLine": 634,
                  "snippet": {
                    "text": "mqtt_pack(&pkt, c->wbuf + c->towrite);\n    c->towrite += len;"
                  }
                }
              },
              "message": {
                "text": "SUBACK append: bound after the retained replay"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 668,
                  "endLine": 669,
                  "snippet": {
                    "text": "mqtt_pack_mono(c->wbuf + c->towrite, UNSUBACK, e->data.unsubscribe.pkt_id);\n    c->towrite += MQTT_ACK_LEN;"
                  }
                }
              },
              "message": {
                "text": "UNSUBACK append: bound against max_request_size"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 767,
                  "endLine": 768,
                  "snippet": {
                    "text": "mqtt_pack_mono(c->wbuf + c->towrite, ptype, orig_mid);\n    c->towrite += MQTT_ACK_LEN;"
                  }
                }
              },
              "message": {
                "text": "PUBACK/PUBREC append: bound against max_request_size"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 811,
                  "endLine": 812,
                  "snippet": {
                    "text": "mqtt_pack_mono(c->wbuf + c->towrite, PUBREL, pkt_id);\n    c->towrite += MQTT_ACK_LEN;"
                  }
                }
              },
              "message": {
                "text": "PUBREL append: bound against max_request_size"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 830,
                  "endLine": 831,
                  "snippet": {
                    "text": "mqtt_pack_mono(c->wbuf + c->towrite, PUBCOMP, pkt_id);\n    c->towrite += MQTT_ACK_LEN;"
                  }
                }
              },
              "message": {
                "text": "PUBCOMP append: bound against max_request_size"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/handlers.c"
                },
                "region": {
                  "startLine": 864,
                  "endLine": 865,
                  "snippet": {
                    "text": "mqtt_pack(&e->data, e->client->wbuf + e->client->towrite);\n    e->client->towrite += MQTT_HEADER_LEN;"
                  }
                }
              },
              "message": {
                "text": "PINGRESP append: bound against max_request_size"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/server.c"
                },
                "region": {
                  "startLine": 338,
                  "endLine": 340,
                  "snippet": {
                    "text": "mqtt_pack(p, c->wbuf + c->towrite);\n                c->towrite += size;\n                enqueue_event_write(c);"
                  }
                }
              },
              "message": {
                "text": "Inflight retransmit (messages): bound the repack"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/server.c"
                },
                "region": {
                  "startLine": 348,
                  "endLine": 356,
                  "snippet": {
                    "text": "struct mqtt_packet ack;\n                mqtt_ack(&ack, i);\n                // Set DUP flag to 1\n                mqtt_set_dup(&ack);\n                size = mqtt_size(&ack, NULL);\n                // Serialize the packet and send it out again\n                mqtt_pack(p, c->wbuf + c->towrite);\n                c->towrite += size;\n                enqueue_event_write(c);"
                  }
                }
              },
              "message": {
                "text": "Inflight retransmit (acks): bound the repack and pack the packet that was sized"
              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "MQTT SUBSCRIBE handler (src/handlers.c subscribe_handler, memcpy at line 617)",
                  "kind": "endpoint"
                }
              ]
            }
          ],
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/server.h"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 142,
                        "endLine": 142
                      },
                      "insertedContent": {
                        "text": "void enqueue_event_write(const struct client *);\n\n/*\n * Reserve len contiguous bytes at the tail of the client write buffer and\n * return a pointer to the reserved area, or NULL when the record does not\n * fit into the max_request_size allocation backing c->wbuf.\n */\nunsigned char *client_wbuf_reserve(struct client *, size_t);"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/server.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 376,
                        "endLine": 380
                      },
                      "insertedContent": {
                        "text": "/*\n * Reserve len contiguous bytes in the client write buffer and return a\n * pointer to the reserved area, or NULL when the record would not fit.\n *\n * c->wbuf is allocated with exactly conf->max_request_size bytes in\n * client_init(), so every producer of outbound bytes has to reserve space\n * through this helper instead of writing at c->wbuf + c->towrite directly.\n * On overflow the record is dropped and logged rather than written past the\n * end of the allocation, and towrite is only advanced when the space was\n * really reserved, so write_data() can never send bytes past the buffer.\n */\nunsigned char *client_wbuf_reserve(struct client *c, size_t len)\n{\n    size_t used  = 0;\n    size_t limit = conf->max_request_size;\n\n    if (!c || !c->wbuf)\n        return NULL;\n\n    used = c->towrite;\n    if (used > limit || len > limit - used) {\n        log_error(\"Write buffer full for %s, dropping %zu bytes (%zu/%zu)\",\n                  c->client_id, len, used, limit);\n        return NULL;\n    }\n\n    c->towrite = used + len;\n\n    return c->wbuf + used;\n}\n\n/*\n * All clients are pre-allocated at the start of the server, but their buffers\n * (read and write) are not, they're lazily allocated with this function, meant\n * to be called on the accept callback\n */"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/handlers.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 227,
                        "endLine": 228
                      },
                      "insertedContent": {
                        "text": "unsigned char *out_buf = client_wbuf_reserve(sc, len);\n        if (out_buf)\n            mqtt_pack(pkt, out_buf);"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/handlers.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 316,
                        "endLine": 317
                      },
