              "risk_area": "Unbounded memory growth / remote resource-exhaustion DoS",
              "surface": "Session teardown for clean_session=false clients (src/server.c client_deactivate, lines 411-451)",
              "recorded_by": "Preauth Logic Validator",
              "source": "agent_reported"
            }
          }
