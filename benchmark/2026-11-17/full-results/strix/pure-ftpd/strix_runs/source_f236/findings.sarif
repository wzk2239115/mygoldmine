          "ruleId": "strix-coverage/ip-access-control-matching-logic-rule-priority-allow-deny-semantics-unknown-host-address-representation",
          "ruleIndex": 55,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "IP access-control matching logic: rule priority, allow/deny semantics, unknown host, address representation — Ruled out: PureDB IPv4 allow/deny rule evaluation (src/log_puredb.c access_ip_check/access_ip_match)\n\nVerified the access_ip_check() decision table for every combination: allow-only (empty allow => unrestricted; match => permitted; malformed CIDR => -1 => denied), deny-only (match or malformed => -1 => denied; no match => permitted), and both (permitted only when allow matches and deny does not). Unknown hostnames resolve to no match (ws_puredb logs and continues) which denies allow-only rules and permits deny-only rules. Dynamic 25-case matrix from 127.0.0.1, ::1 and ::ffff:127.0.0.1 covered /32, /8, hostname, comma lists, malformed /33, /0, leading-zero octets and both-lists cases; all behaved as specified, including IPv4 deny applied to the IPv4-mapped client."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "PureDB IPv4 allow/deny rule evaluation (src/log_puredb.c access_ip_check/access_ip_match)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
