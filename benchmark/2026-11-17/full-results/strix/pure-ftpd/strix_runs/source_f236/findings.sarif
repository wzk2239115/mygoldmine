        {
          "ruleId": "strix-coverage/half-updated-data-address-port-state-after-a-failed-port-eprt-parse",
          "ruleIndex": 51,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Half-updated data-address/port state after a failed PORT/EPRT parse — Ruled out: PORT/EPRT parse-failure state reset in src/ftpd.c (doport, doeprt, do_ipv6_port, doport2)\n\nBoth failure paths reset the data channel state: doport() closes datafd and sets it to -1 on a parse error, doeprt()/do_ipv6_port() jump to the shared `nope:` label which closes datafd and sets -1 before replying 501, and doport2() closes datafd before returning on the p<1024, doport3 failure and FXP-rejection branches. peerdataport is only updated after doport3() succeeds, and the peer address is only replaced when allowfxp permits FXP. Verified dynamically: a successful PORT followed by a malformed PORT/EPRT leaves no data socket (subsequent LIST returns 425 rather than connecting to the old target), and a malformed EPRT after PASV does not disturb passive semantics."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "PORT/EPRT parse-failure state reset in src/ftpd.c (doport, doeprt, do_ipv6_port, doport2)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
