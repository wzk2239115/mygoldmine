              "risk_area": "Buffer overflow / auth bypass on short or oversized auth-daemon reply (WITH_EXTAUTH)",
              "surface": "src/log_extauth.c + src/pure-authd.c request/response framing",
              "recorded_by": "CLI Tools And Scoreboard Auditor",
