            {
              "id": "strix-coverage/username-buffer-handling-null-termination-conversation-overflow",
              "name": "Username buffer handling / null termination / conversation overflow",
              "shortDescription": {
                "text": "Coverage: Username buffer handling / null termination / conversation overflow"
