              "risk_area": "Security-context selection semantics / ID-context downgrade (zero-length id_context)",
              "surface": "src/oscore/oscore_context.c oscore_find_context non-callback path + oscore_duplicate_ctx zero-length id_context",
              "recorded_by": "OSCORE Crypto Audit",
