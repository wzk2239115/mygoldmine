│  1\\n\", executed);\n\n    fprintf(stderr, \"-- replaying captured record    │
│  verbatim --\\n\");\n    r = tls_consume_stream(srv, rec1.buf, rec1.len,     │
│  cb);\n    drain(srv, &s2c);\n    k = tls_read(srv, app, sizeof(app) -       │
│  1);\n    if (k > 0) { app[k] = 0; executed++; replay_executed++;            │
│  fprintf(stderr, \"[app] executed #%i AGAIN: '%s' (consume=%i)\\n\",         │
│  executed, app, r); }\n    else fprintf(stderr, \"replay rejected:           │
│  consume=%i read=%i\\n\", r, k);\n\n    r = tls_consume_stream(srv,          │
│  rec1.buf, rec1.len, cb);\n    drain(srv, &s2c);\n    if (tls_read(srv,      │
│  app, sizeof(app) - 1) > 0) { executed++; replay_executed++;                 │
│  fprintf(stderr, \"[app] executed #%i once more\\n\", executed); }\n\n       │
│  printf(\"RESULT handshake=ok commands_sent=12 commands_executed=%i          │
