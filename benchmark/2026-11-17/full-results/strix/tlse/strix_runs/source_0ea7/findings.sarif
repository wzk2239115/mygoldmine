          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "tlse.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 1937,
                        "endLine": 1947
                      },
                      "insertedContent": {
                        "text": "#define TLS_DTLS_REPLAY_WINDOW 512\n\nstruct DTLSData {\n    struct TLSHandshakeList *dtls_handshake_list;\n    struct DTLSFragment *fragment;\n    unsigned char *key_exchange;\n    unsigned int key_exchange_len;\n#ifdef TLS_DTLS_EXTENDED_MASTER_SECRET\n    unsigned char extended_master_secret;\n#endif\n    unsigned char has_random;\n    char *remote_fingerprint;\n    /*  RFC 6347 4.1.2.6 anti-replay state */\n    uint64_t replay_highest;\n    unsigned char replay_bitmap[TLS_DTLS_REPLAY_WINDOW / 8];\n    unsigned char replay_initialized;\n};"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "tlse.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 10428,
                        "endLine": 10429
                      },
                      "insertedContent": {
                        "text": "/*  RFC 6347 4.1.2.6 anti-replay window: a record is acceptable when it is newer\n    than the window, or unseen inside it. This only reads the window state; the\n    window is advanced by _private_dtls_replay_update() once the record has been\n    authenticated, so forged records cannot move it. */\nint _private_dtls_replay_acceptable(struct TLSContext *context, uint64_t sequence_number) {\n    struct DTLSData *dtls;\n    if (!context)\n        return 1;\n    dtls = context->dtls_data;\n    if ((!dtls) || (!dtls->replay_initialized))\n        return 1;\n    if (sequence_number > dtls->replay_highest)\n        return 1;\n    if ((dtls->replay_highest - sequence_number) >= TLS_DTLS_REPLAY_WINDOW)\n        return 0;\n    return ((dtls->replay_bitmap[(sequence_number >> 3) % (TLS_DTLS_REPLAY_WINDOW / 8)] >> (sequence_number & 7)) & 1) ? 0 : 1;\n}\n\nvoid _private_dtls_replay_update(struct TLSContext *context, uint64_t sequence_number) {\n    struct DTLSData *dtls;\n    uint64_t index;\n    if ((!context) || (!(dtls = context->dtls_data)))\n        return;\n    if (sequence_number > dtls->replay_highest) {\n        if ((!dtls->replay_initialized) || ((sequence_number - dtls->replay_highest) >= TLS_DTLS_REPLAY_WINDOW)) {\n            memset(dtls->replay_bitmap, 0, sizeof(dtls->replay_bitmap));\n        } else {\n            for (index = dtls->replay_highest + 1; index < sequence_number; index++)\n                dtls->replay_bitmap[(index >> 3) % (TLS_DTLS_REPLAY_WINDOW / 8)] &= (unsigned char)~(1 << (index & 7));\n        }\n        dtls->replay_highest = sequence_number;\n    }\n    dtls->replay_bitmap[(sequence_number >> 3) % (TLS_DTLS_REPLAY_WINDOW / 8)] |= (unsigned char)(1 << (sequence_number & 7));\n    dtls->replay_initialized = 1;\n}\n\nint tls_parse_message(struct TLSContext *context, unsigned char *buf, int buf_len, tls_validation_function certificate_verify) {\n    int header_size;"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "tlse.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 10489,
                        "endLine": 10494
                      },
                      "insertedContent": {
                        "text": "if ((context->cipher_spec_set) && (type != TLS_CHANGE_CIPHER)) {\n        unsigned char aad[16];\n        int aad_size;\n        unsigned char *sequence;\n        /*  DTLS records that are too old or already seen are dropped before any\n            decryption work is done (RFC 6347 4.1.2.6) */\n        if ((context->dtls) && (context->crypto.created) && (!_private_dtls_replay_acceptable(context, dtls_sequence_number))) {\n            DEBUG_PRINT0(\"DTLS REPLAYED RECORD DROPPED\\n\");\n            return header_size + length;\n        }\n        /* AEAD records must carry at least the 8-byte explicit nonce #141 */\n        if ((context->crypto.created == 2) && (length < 8)) {"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "tlse.c"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 10787,
                        "endLine": 10791
                      },
                      "insertedContent": {
                        "text": "if (context->dtls) {\n        context->dtls_epoch_remote = dtls_epoch;\n        context->remote_sequence_number = dtls_sequence_number & (((uint64_t)0xFFFFUL << 32) | 0xFFFFFFFFUL);\n        /*  the record was authenticated: let it advance the anti-replay window */\n        if ((context->cipher_spec_set) && (type != TLS_CHANGE_CIPHER))\n            _private_dtls_replay_update(context, dtls_sequence_number);\n    } else\n        context->remote_sequence_number ++;"
                      }
                    }
                  ]
                }
              ],
              "description": {
                "text": "Implement the anti-replay window that RFC 6347 section 4.1.2.6 requires for every DTLS context: retain the highest authenticated record sequence number together with a bitmap covering the preceding records (512 records is the usual size), drop any record that is older than the window or whose bit is already set, and advance the window only after the record's AEAD tag has verified so that forged datagrams cannot move it. Sequence numbers must be compared per direction and per epoch, and the window must reset when the epoch advances. Records rejected as duplicates should be discarded silently rather than answered with an alert, so that a replayed datagram does not produce an error response an attacker can use as an oracle. If contexts are exported and imported between processes in the middle of a DTLS association, serialize the window state as well, or document that the receiving process starts with an empty window.",
                "markdown": "Implement the anti-replay window that RFC 6347 section 4.1.2.6 requires for every DTLS context: retain the highest authenticated record sequence number together with a bitmap covering the preceding records (512 records is the usual size), drop any record that is older than the window or whose bit is already set, and advance the window only after the record's AEAD tag has verified so that forged datagrams cannot move it. Sequence numbers must be compared per direction and per epoch, and the window must reset when the epoch advances. Records rejected as duplicates should be discarded silently rather than answered with an alert, so that a replayed datagram does not produce an error response an attacker can use as an oracle. If contexts are exported and imported between processes in the middle of a DTLS association, serialize the window state as well, or document that the receiving process starts with an empty window."
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "5e0ec370f2b31cbb87dc8393c5294158c69262d620e9dbcfe629161133f58833"
          },
          "properties": {
            "security-severity": "4.3",
            "strix_vuln_class_hash": "95f03294a6a9e71f1a90a1bfc803b515035fd6982b94fa4f50b82396a6ab773d",
            "strix": {
              "id": "vuln-0012",
              "severity": "medium",
              "cvss": 4.3,
              "timestamp": "2026-11-17 11:13:39 UTC",
              "target": "/workspace/source",
              "endpoint": "tlse.c — DTLS record layer (tls_parse_message / tls_consume_stream)",
              "method": "DTLS 1.2 record replay",
              "cwe": "CWE-294",
              "impact": "A previously valid DTLS record can be re-injected arbitrarily often and arbitrarily late in the connection, and the receiving application processes it as a fresh message each time. In the demonstrated case one command record was executed three times (once originally, twice by replay) after the peer's sequence had advanced eleven records past it, so no time or sequence proximity is required. Any DTLS-protected operation with side effects is exposed: duplicate transfers or provisioning commands, re-executed alarms or control actions, replayed chat/media-control messages on the library's WebRTC data channels, and double counting in metered or billable flows. Integrity impact scales with what the duplicated message does; confidentiality is unaffected because the replayed ciphertext is unmodified.",
              "technical_analysis": "**The DTLS record layer has no anti-replay state.** `tls_parse_message()` reads the epoch and sequence number straight out of each received record:\\n\\n```c title=tlse.c startLineNumber=10456 endLineNumber=10462\\n    if (context->dtls) {\\n        CHECK_SIZE(buf_pos + 8, buf_len, TLS_NEED_MORE_DATA)\\n        dtls_epoch = ntohs(*(unsigned short *)&buf[buf_pos]);\\n        dtls_sequence_number = ntohll(*(uint64_t *)&buf[buf_pos]);\\n\\n        buf_pos += 8;\\n    }\\n```\\n\\nThose same attacker-supplied values become the AEAD additional data and nonce, so decryption is self-consistent for any record that was ever valid:\\n\\n```c title=tlse.c startLineNumber=10554 endLineNumber=10557\\n                if (context->dtls)\\n                    *((uint64_t *)aad) = htonll(dtls_sequence_number);\\n                else\\n                    *((uint64_t *)aad) = htonll(context->remote_sequence_number);\\n```\\n\\nThe value is then stored with no comparison against any previous value:\\n\\n```c title=tlse.c startLineNumber=10787 endLineNumber=10791\\n    if (context->dtls) {\\n        context->dtls_epoch_remote = dtls_epoch;\\n        context->remote_sequence_number = dtls_sequence_number & (((uint64_t)0xFFFFUL << 32) | 0xFFFFFFFFUL);\\n    } else\\n        context->remote_sequence_number ++;\\n```\\n\\nThere is no highest-seen counter, no bitmap or cache of accepted sequence numbers, and no epoch comparison (`grep` for replay/window/highest over `tlse.c` and `tlse.h` returns nothing relevant; `remote_sequence_number` is only used as a nonce input for stream TLS). Once the tag verifies, the record goes to `_private_tls_write_app_data()` (`tlse.c:10823`) and out of `tls_read()`, so the application processes the duplicated message exactly like the original. RFC 6347 section 4.1.2.6 requires the record layer to implement a replay detection window; the README's own warning about the DTLS state machine covers DoS, not replay.\\n\\nBecause the check is absent rather than weak, the attack needs no cryptography: any party that can observe one datagram (an on-path attacker, a shared wireless segment, or the peer itself) can re-inject it at any later point in the connection, and the library reports nothing to the application that would distinguish the copy from a fresh record. The same code path serves the WebRTC/DTLS peer connection shim (`tls_peerconnection_iterate()` feeds datagrams to `tls_consume_stream()`), so data-channel messages are equally replayable.",
              "remediation_steps": "Implement the anti-replay window that RFC 6347 section 4.1.2.6 requires for every DTLS context: retain the highest authenticated record sequence number together with a bitmap covering the preceding records (512 records is the usual size), drop any record that is older than the window or whose bit is already set, and advance the window only after the record's AEAD tag has verified so that forged datagrams cannot move it. Sequence numbers must be compared per direction and per epoch, and the window must reset when the epoch advances. Records rejected as duplicates should be discarded silently rather than answered with an alert, so that a replayed datagram does not produce an error response an attacker can use as an oracle. If contexts are exported and imported between processes in the middle of a DTLS association, serialize the window state as well, or document that the receiving process starts with an empty window.",
              "counterevidence": "The strongest argument against this being exploitable is that DTLS is often used only for media or for request/response traffic where a duplicated record is harmless, and that a replayed record cannot be modified (the AEAD tag still binds the ciphertext), so confidentiality is untouched. That does not remove the issue: RFC 6347 section 4.1.2.6 makes an anti-replay window mandatory, precisely because duplicated records are indistinguishable from fresh ones for the application. I looked for an existing control and found none — no highest-seen counter, no bitmap, no duplicate cache; `context->remote_sequence_number` is overwritten from the record header on every datagram (`tlse.c:10787-10789`) and the AEAD nonce/AAD are built from the record's own epoch and sequence (`tlse.c:10554-10557`), so a captured record stays valid forever and can be re-delivered at any time, in any position in the stream. I also confirmed that the library does not reject the replay anywhere downstream: `tls_parse_message` dispatches the record to `_private_tls_write_app_data()` and `tls_read()` returns it, exactly like the first delivery. A deployment-level idempotency key would mitigate a specific application but is not a protocol-level control and is not provided by the library.",
              "confidence": "high",
              "confidence_rationale": "The exchange, the replay, and the fix are all exercised end to end in-process against an unmodified build of this source and against the rebuilt patched tree. The only deployment-specific unknown is how much of a given application's DTLS traffic is side-effecting.",
              "severity_change_conditions": "If a deployment uses DTLS for media or idempotent request/response traffic only, the integrity impact disappears and this drops to low; if the DTLS channel carries privileged control commands or money-moving operations, or if an off-path attacker can capture a datagram from any vantage point (making privileges-required none), the score rises to high because the replay is then unauthenticated and directly changes protected state.",
              "fix_verification": "**Gate 1 — security closure.** The four edits were applied to a copy of the snapshot and the PoC was rebuilt against it. The captured record (epoch 1, sequence 1) is now rejected on both replay attempts while the original delivery still works: `consume=53 read=0`, and the application executes exactly the 12 commands the peer sent (`commands_executed=12 console_effects=0`) instead of 14. The record is dropped before decryption, i.e. before any AEAD work and before `_private_tls_write_app_data()`, so no plaintext reaches the application on a replay.\\n\\n**Gate 2 — bypass review.** (a) A replay positioned before the window is covered by the `highest - sequence_number >= TLS_DTLS_REPLAY_WINDOW` branch (tested with a record eleven sequence numbers old); (b) a duplicate of the newest record is covered by the bitmap bit already being set — verified in the separate reordering run (`dup 3 dropped`); (c) a duplicate inside the window that was never delivered is still accepted, so legitimate reordering is not broken (records 3, 2, 1 out of order were all delivered); (d) the window is advanced only after the tag check, so an attacker cannot poison it with forged records carrying huge sequence numbers — with the update placed after authentication, a bogus record returns early on `TLS_BROKEN_PACKET`/`TLS_INTEGRITY_FAILED` and never reaches the update; (e) an epoch change (CCS, which increments `dtls_epoch_remote`) produces a combined sequence jump larger than the window, which clears the bitmap and moves the window forward, so old-epoch records become too old instead of being accepted; (f) the same applies to DTLS 1.0 and DTLS 1.3 records, which share `tls_parse_message` and are gated on `context->cipher_spec_set` rather than a version. The clearing loop is bounded by the window size (it memsets instead of looping when the jump is larger than the window), so a peer cannot cause unbounded work with a large sequence jump. Remaining gap: handshake retransmissions from the peer are now dropped as duplicates, which is the intended RFC 6347 behaviour, but no test exercises a lossy network or the library's DTLS retransmission path.\\n\\n**Gate 3 — preserved behavior.** The full DTLS 1.2 handshake still completes (`established=1` on both sides) and application data flows in both directions; out-of-order delivery inside the window is accepted in the order received; TLS (non-DTLS) record handling is untouched because every new condition is guarded by `context->dtls`. The mTLS gate matrix from the independent client-authentication fix was re-run on the combined patched tree and behaves identically (unauthenticated peers rejected, CA-signed peer accepted), confirming the two changes do not interact.\\n\\n**Gate 4 — repository checks.** `gcc -DTLS_AMALGAMATION -O2 -Wall -Wextra -c tlse.c` compiles with no diagnostics in the changed regions; the harness binaries for the replay PoC, the reordering test and the mTLS matrix all build and run. The repository ships no test suite, so there is no project test target. Narrowest-complete-change judgement: a bitmap window is the smallest construct that both satisfies RFC 6347 and preserves DTLS reordering; a plain high-water mark would reject legitimate out-of-order records and was rejected for that reason. Window state is intentionally not serialized by `tls_export_context()`, which is noted as a limitation rather than silently half-implemented.",
              "poc": {
                "description": "1. Build the PoC against the library: `gcc -DTLS_AMALGAMATION -g -O0 -o dtls_replay dtls_replay.c` (it `#include`s `tlse.c` and drives both endpoints in one process over an in-memory datagram queue).\\n2. Run `./dtls_replay server_cert.pem server_key.pem` with a certificate and key for the server. The harness completes a full DTLS 1.2 handshake (`established=1` on both sides, `ECDHE-RSA-AES128GCM-SHA256`).\\n3. The client sends `CMD:TRANSFER-100`; the harness keeps a byte-exact copy of that datagram and prints its DTLS header (`type=17 epoch=1 seq=1`).\\n4. The client then sends eleven further records, moving its sequence number to 12.\\n5. The harness re-delivers the captured datagram verbatim. `tls_consume_stream()` consumes all 53 bytes and `tls_read()` returns `CMD:TRANSFER-100` again, so the application executes the command a second time; a second immediate replay does the same.\\n6. Apply the remediation, rebuild, and re-run: the replays are dropped (`consume=53 read=0`) and exactly 12 commands execute; a separate run confirms out-of-order records inside the window are still delivered while duplicates are dropped.",
                "script_available": true
              }
            }
          }
        },
        {
          "ruleId": "strix-coverage/record-type-confusion-premature-application-data",
          "ruleIndex": 9,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "record type confusion / premature application data — No issue identified: TLS 1.3 inner plaintext content-type stripping\n\nAfter AEAD verification, trailing zero bytes are stripped from the inner plaintext and the last non-zero byte is taken as the content type (tlse.c:10815-10830), the standard RFC 8446 rule. Application data is only delivered when connection_status == 0xFF; handshake and alert paths are gated by handshakebufferlength. Outer type is only trusted for unencrypted records."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "TLS 1.3 inner plaintext content-type stripping"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "record type confusion / premature application data",
              "surface": "TLS 1.3 inner plaintext content-type stripping",
              "recorded_by": "TLS 1.3, State Machine &amp; STUN/SRTP Auditor",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/nonce-reuse-wrong-key-per-record",
          "ruleIndex": 10,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "nonce reuse / wrong-key-per-record — No issue identified: TLS 1.3 record protection: AEAD additional data, nonce construction, epoch/sequence handling\n\nEncrypt (tlse.c:5188-5300) and decrypt (tlse.c:10540-10610) reviewed and are symmetric: AAD is the 5-byte TLSInnerPlaintext header with the ciphertext length (plaintext length + type byte + 16 tag, matching on both sides), inner type appended before AAD construction, nonce = static_iv XOR 8-byte big-endian sequence at offset 4. Sequence is incremented once per record in tls_packet_update and reset to 0 at both TLS 1.3 key changes (tlse.c:10107, tls_parse_finished). No path encrypts two records with the same (key, nonce)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "TLS 1.3 record protection: AEAD additional data, nonce construction, epoch/sequence handling"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "nonce reuse / wrong-key-per-record",
              "surface": "TLS 1.3 record protection: AEAD additional data, nonce construction, epoch/sequence handling",
              "recorded_by": "TLS 1.3, State Machine &amp; STUN/SRTP Auditor",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/changecipherspec-ordering-premature-application-data",
          "ruleIndex": 11,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "ChangeCipherSpec ordering / premature application data — Ruled out: TLS 1.0-1.2 ChangeCipherSpec acceptance\n\nControl named and checked: the ChangeCipherSpec handler only accepts CCS when connection_status == 2 and the non-DTLS path otherwise emits unexpected_message (tlse.c:10880-10900); for TLS 1.3 an early guard requires length 1, value 1 and connection_status != 0xFF before the record is dropped (tlse.c:10480). A repeated CCS at status 2 only resets remote_sequence_number, which desynchronises the record MAC stream (denial of service, not a bypass)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "TLS 1.0-1.2 ChangeCipherSpec acceptance"
                }
              ]
            }
          ],
          "properties": {
