{
  "name": "vul-ai-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "smoke": "node scripts/api-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:system": "npm run build && node scripts/system-test.mjs",
    "prestart": "python3 ../scripts/workflow/build_state.py || true; python3 ../scripts/workflow/fetch_project_logos.py --timeout 8 || true; python3 ../scripts/workflow/report_quality.py || true"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^0.515.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "unified": "11.0.5",
    "remark-parse": "11.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.4"
  }
}
